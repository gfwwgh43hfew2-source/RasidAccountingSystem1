<UserControl x:Class="RasidAccountingSystem.Views.CustomerStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="{StaticResource BackgroundColor}"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ==================== الألوان ==================== -->
        <SolidColorBrush x:Key="CustomerPrimaryColor" Color="#10B981"/>
        <SolidColorBrush x:Key="CustomerPrimaryDark" Color="#059669"/>
        <SolidColorBrush x:Key="CustomerPrimarySoft" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6C757D"/>
        <SolidColorBrush x:Key="BorderLightColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BackgroundGrayColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>

        <!-- ==================== الظلال ==================== -->
        <DropShadowEffect x:Key="ShadowSm" 
                          BlurRadius="8" 
                          ShadowDepth="1" 
                          Opacity="0.08" 
                          Direction="270"/>

        <!-- ✅ (خطوة 5): ظل أعمق شوية للكروت الرئيسية (الهيدر وجدول الحركات) عشان يبقى فيه
             إحساس أوضح بالطبقات (depth) بدل ما كل حاجة تبان مسطحة على نفس المستوى -->
        <DropShadowEffect x:Key="ShadowMd" 
                          BlurRadius="16" 
                          ShadowDepth="3" 
                          Opacity="0.10" 
                          Direction="270"
                          Color="#0F172A"/>

        <!-- ==================== تعريف الأنماط ==================== -->

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ (خطوة 4): نفس ستايل حقل بحث العميل المستخدم في فاتورة المبيعات -->
        <Style x:Key="CustomerSearchTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ✅ (خطوة 4): نفس ستايل قائمة اقتراحات العميل المستخدمة في فاتورة المبيعات -->
        <Style x:Key="CustomerSuggestionListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Focusable" Value="True"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource CustomerPrimarySoft}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{StaticResource CustomerPrimarySoft}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="TextBox"
                                                   Grid.Column="0"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cairo"
                                                   FontSize="11"/>
                                <Button x:Name="DropDownButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <TextBlock Text="📅"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryColor}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Width="30"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <TextBlock x:Name="arrow"
                                                               Text="▼"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="▲"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Grid Width="{TemplateBinding ActualWidth}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderLightColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,1,0,0">
                                        <ScrollViewer MaxHeight="180">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource CustomerPrimaryColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CustomerPrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CustomerPrimaryColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource CustomerPrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource CustomerPrimarySoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E7E41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Excel" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E4F7A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖨️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="طباعة" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#143D5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CustomerPrimarySoft}"/>
            <Setter Property="Foreground" Value="{StaticResource CustomerPrimaryColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource CustomerPrimarySoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MaxWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#A0B4C8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Height="{TemplateBinding Height}"
                                                        Width="6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#7A8EAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== العنوان ==================== -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="12"
                Padding="0"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowMd}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- شريط لوني جانبي يميّز هوية شاشة العملاء -->
                <Border Grid.Column="0"
                        Background="{StaticResource CustomerPrimaryColor}"
                        CornerRadius="12,0,0,12"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,12,15,12" VerticalAlignment="Center">
                    <Border Background="{StaticResource CustomerPrimarySoft}"
                            CornerRadius="10"
                            Width="38"
                            Height="38">
                        <TextBlock Text="👤"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="كشف حساب العميل"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   FontFamily="Cairo"/>
                        <TextBlock Text="متابعة حركات وأرصدة العملاء بالتفصيل"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontFamily="Cairo"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,12,15,12" VerticalAlignment="Center">
                    <Button x:Name="btnRefresh"
                            Content="⟳ تحديث"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Width="80"/>
                    <Button x:Name="btnExportExcel"
                            Content="📊 Excel"
                            Style="{StaticResource ExcelButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== شريط الفلاتر ==================== -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- صف 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="اختر العميل" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <TextBox x:Name="txtCustomerSearch"
                                 Style="{StaticResource CustomerSearchTextBox}"
                                 TextChanged="TxtCustomerSearch_TextChanged"
                                 GotFocus="TxtCustomerSearch_GotFocus"
                                 LostFocus="TxtCustomerSearch_LostFocus"
                                 PreviewKeyDown="TxtCustomerSearch_PreviewKeyDown"/>

                        <TextBlock x:Name="txtCustomerPlaceholder"
                                   Text="🔍 ابحث باسم العميل أو الكود..."
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#999999"
                                   IsHitTestVisible="False"
                                   FontFamily="Cairo"
                                   FontSize="11"/>

                        <!-- ✅ (خطوة 4): نفس تحكم حقل العميل في فاتورة المبيعات — Popup يفضل مفتوح
                             (StaysOpen) والتنقل بالأسهم بيتم من غير ما الفوكس يسيب التكست بوكس -->
                        <Popup x:Name="popupCustomers"
                               PlacementTarget="{Binding ElementName=txtCustomerSearch}"
                               Placement="Bottom"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               Width="{Binding ActualWidth, ElementName=txtCustomerSearch}">
                            <Border Background="White"
                                    BorderBrush="{StaticResource BorderLightColor}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MaxHeight="220"
                                    Effect="{StaticResource ShadowSm}">
                                <ListBox x:Name="lstCustomers"
                                         Style="{StaticResource CustomerSuggestionListBox}"
                                         MouseUp="LstCustomers_MouseUp"
                                         PreviewKeyDown="LstCustomers_PreviewKeyDown"
                                         SelectionChanged="LstCustomers_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="Cairo"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryColor}"/>
                                                    <TextBlock Text="{Binding Code}"
                                                               FontFamily="Cairo"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource CustomerPrimarySoft}"
                                                        CornerRadius="4"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Cairo"
                                                               FontSize="10"
                                                               Foreground="{StaticResource CustomerPrimaryColor}"
                                                               Text="{Binding CurrentBalance, StringFormat=رصيد: {0:N2}}"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="من تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpFromDate" Style="{StaticResource FormDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpToDate" Style="{StaticResource FormDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,10">
                    <TextBlock Text="نوع الحركة" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="cboTransactionType" 
                              Style="{StaticResource FormComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="الكل"/>
                        <ComboBoxItem Content="مبيعات"/>
                        <ComboBoxItem Content="تحصيلات"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <Button x:Name="btnShowStatement"
                            Content="🔍 عرض الكشف"
                            Style="{StaticResource PrimaryButton}"
                            Width="120"/>
                </StackPanel>

                <!-- صف 2 - معلومات العميل: بطاقات إحصائية صغيرة بدل الشريط المسطح -->
                <Border Grid.Row="1" Grid.ColumnSpan="5"
                        Background="{StaticResource BackgroundGrayColor}"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0,10,0,0"
                        x:Name="borderCustomerInfo"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                BorderBrush="{StaticResource CustomerPrimaryColor}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="اسم العميل" 
                                           FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblCustomerName" 
                                           Text="---" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                BorderBrush="{StaticResource CustomerPrimaryColor}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="الكود" 
                                           FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblCustomerCode" 
                                           Text="---" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                BorderBrush="{StaticResource CustomerPrimaryColor}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="رصيد افتتاحي" 
                                           FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblOpeningBalance" 
                                           Text="0.00" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource CustomerPrimaryColor}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,6,0"
                                BorderBrush="{StaticResource DangerColor}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="إجمالي المبيعات (مدين)" 
                                           FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblTotalSales" 
                                           Text="0.00" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource DangerColor}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Background="White" CornerRadius="8" Padding="10,8"
                                BorderBrush="{StaticResource SuccessColor}" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="إجمالي التحصيلات (دائن)" 
                                           FontSize="10" 
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblTotalReceipts" 
                                           Text="0.00" 
                                           FontSize="13" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessColor}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== كشف الحساب ==================== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowMd}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- عنوان الجدول -->
                <Border Grid.Row="0"
                        Background="{StaticResource CustomerPrimarySoft}"
                        Padding="15,10"
                        CornerRadius="12,12,0,0"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 تفاصيل الحركات"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CustomerPrimaryColor}"
                                   FontFamily="Cairo"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="lblRecordsCount"
                                   Text="عدد السجلات: 0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontFamily="Cairo"/>
                    </Grid>
                </Border>

                <!-- جدول البيانات -->
                <DataGrid x:Name="dgTransactions"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource SurfaceColor}"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="{StaticResource SurfaceColor}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="📅 التاريخ" 
                                            Binding="{Binding TransactionDate}" 
                                            Width="100"/>

                        <DataGridTextColumn Header="📄 نوع المستند" 
                                            Binding="{Binding DocumentType}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="🔢 رقم المستند" 
                                            Binding="{Binding DocumentNumber}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="📝 البيان" 
                                            Binding="{Binding Description}" 
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- مدين (مبيعات) - يزيد رصيد العميل -->
                        <DataGridTextColumn Header="💰 مدين (مبيعات)" 
                                            Binding="{Binding DebitAmount, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- دائن (تحصيلات) - يقلل رصيد العميل -->
                        <DataGridTextColumn Header="💳 دائن (تحصيلات)" 
                                            Binding="{Binding CreditAmount, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="⚖️ الرصيد بعد" 
                                            Binding="{Binding BalanceAfter, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{Binding BalanceColor}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- شريط الإجمالي -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        Padding="15,12"
                        CornerRadius="0,0,12,12"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الرصيد النهائي:" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblClosingBalance" 
                                       Text="0.00" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource CustomerPrimaryColor}" 
                                       Margin="10,0,0,0"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblClosingBalanceCurrency"
                                       Text="ر.س" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}" 
                                       Margin="5,0,0,0" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,20,0">
                            <TextBlock Text="إجمالي المبيعات (مدين):" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalDebit" 
                                       Text="0.00" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource DangerColor}" 
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="إجمالي التحصيلات (دائن):" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalCredit" 
                                       Text="0.00" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource SuccessColor}" 
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- عمود صافي الحركة -->
                        <Border Grid.Column="3" 
                                Background="{StaticResource CustomerPrimarySoft}" 
                                CornerRadius="10" 
                                Padding="12,8"
                                Margin="15,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="صافي الحركة:" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock x:Name="lblNetChange" 
                                           Text="0.00" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource CustomerPrimaryColor}" 
                                           Margin="8,0,0,0"/>
                                <TextBlock x:Name="lblNetChangeCurrency" Text="ر.س" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- رسالة عدم وجود بيانات -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundGrayColor}"
                CornerRadius="10"
                Padding="40"
                x:Name="lblNoData"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="لا توجد حركات للعميل في الفترة المحددة"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryColor}"
                           HorizontalAlignment="Center"
                           FontFamily="Cairo"/>
                <TextBlock Text="الرجاء اختيار عميل آخر أو تغيير نطاق التواريخ"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           FontFamily="Cairo"/>
                <Button x:Name="btnResetFilters"
                        Style="{StaticResource SecondaryButton}"
                        Width="140"
                        Height="34"
                        Margin="0,15,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="إعادة ضبط الفلاتر"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>