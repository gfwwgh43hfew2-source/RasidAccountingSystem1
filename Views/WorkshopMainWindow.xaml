<Window x:Class="RasidAccountingSystem.Views.WorkshopMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RasidAccountingSystem.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="الورشة"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">

    <!--
        ==========================================================================
        WorkshopMainWindow.xaml — الهيكل العام التجريبي لبرنامج "الورشة"
        ==========================================================================
        نافذة تجريبية منفصلة تمامًا عن MainWindow.xaml الإنتاجي الحالي.
        الهدف من هذه الخطوة: الاتفاق على شكل الإطار العام (Sidebar + Header
        + منطقة محتوى) قبل اتخاذ قرار استبدال MainWindow.xaml الفعلي أو
        دمج هذا الهيكل بداخله تدريجيًا (قرار مقترح في الخطوة التالية).

        منطقة المحتوى في النص حاليًا Placeholder فاضي (بدون أي Dashboard
        حقيقي بعد) — بناء الـDashboard نفسه هو المرحلة التالية في الخطة
        الأصلية (المرحلة 4)، ومُتعمَّد الفصل بينه وبين هيكل الإطار العام
        هنا حتى تكون كل خطوة قابلة للمراجعة بمفردها.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/WorkshopTheme.xaml"/>

                <!--
                    [WPF-UI Integration — مهمة 2] دمج مكتبة WPF-UI هنا فقط
                    (جوا هذه النافذة التجريبية)، بدون لمس App.xaml الإنتاجي.
                    ThemesDictionary + ControlsDictionary هما الحد الأدنى
                    المطلوب حسب توثيق المكتبة الرسمي (wpfui.lepo.co) عشان
                    أي عنصر WPF-UI (زي NavigationView المتخطط ليه في مهمة 3)
                    يشتغل صح. ثيم "Light" مبدئي بس لإثبات إن المكتبة محمّلة —
                    قابل للتغيير بسهولة لاحقًا.
                -->
                <ui:ThemesDictionary Theme="Light"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>

            <!-- زرار أيقونة دائري بسيط للهيدر (إشعارات/إعدادات) -->
            <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusPill}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverSurfaceBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== الشريط الجانبي (Column 0 هنا = يمين فعليًا تحت RTL) ===================== -->
        <views:WorkshopSidebar x:Name="Sidebar" Grid.Column="0"/>

        <!-- ===================== منطقة المحتوى (Header + Content) ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== Header ===================== -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- اسم الورشة الحالية (Placeholder — من إعدادات النظام لاحقًا) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ورشة الأمانة لصيانة السيارات" Style="{StaticResource TextH3Style}"/>
                        <TextBlock Text="مرحبًا، أحمد" Style="{StaticResource TextCaptionStyle}"/>
                    </StackPanel>

                    <!-- البحث السريع (منتصف الهيدر) — حدّ واضح + أيقونة بلون التمييز بدل شريط مسطّح بلا هوية -->
                    <Border Grid.Column="1" Background="{StaticResource AppBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="{StaticResource BorderThin}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Height="42" MaxWidth="460" Margin="32,0"
                            HorizontalAlignment="Stretch">
                        <DockPanel Margin="14,0" LastChildFill="True">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="ابحث برقم الهاتف، رقم اللوحة، أو اسم العميل..."
                                       Style="{StaticResource TextMutedStyle}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>
                    </Border>

                    <!-- الإشعارات + إعدادات الحساب -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource HeaderIconButtonStyle}" Margin="6,0">
                            <Grid>
                                <TextBlock Text="&#xE7E7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"/>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="8"
                                        Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"/>
                            </Grid>
                        </Button>
                        <Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Style="{StaticResource HeaderIconButtonStyle}" Margin="6,0"/>
                        <Border Width="1" Height="26" Background="{StaticResource BorderBrush2}" Margin="10,0"/>
                        <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusPill}"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="أ" FontWeight="Bold" Foreground="{StaticResource AccentDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== منطقة المحتوى — Dashboard حقيقي (أرقام Placeholder شكلية، بدون قاعدة بيانات بعد) ===================== -->
            <ScrollViewer x:Name="DashboardView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="نظرة عامة على اليوم" Style="{StaticResource TextH2Style}" Margin="0,0,0,4"/>
                    <TextBlock Text="أرقام تجريبية للمعاينة فقط — سيتم ربطها بقاعدة البيانات الفعلية في خطوة تالية"
                               Style="{StaticResource TextMutedStyle}" Margin="0,0,0,16"/>

                    <!--
                        ===== لوحة العمليات الآن — شريط داكن متصل واحد بدل 5 صناديق منفصلة =====
                        قرار تصميم (رد على ملاحظة "الشكل بدائي/شكل قوالب"): الأرقام الخمسة اللي
                        كانت متوزّعة على كارت بطل + 4 بلاطات منفصلة في قسمين مختلفين من الشاشة
                        اتلمّت في لوحة واحدة متصلة بخلفية داكنة موحّدة، مقسّمة بفواصل رأسية رفيعة
                        بدل حدود صناديق منفصلة. الرقم الأهم تشغيليًا ("سيارات داخل الورشة الآن")
                        أكبر خط ووحيد اللي تحته توزيع فرعي بالنقاط، والباقي أرقام مساندة بنفس
                        الارتفاع لكن خط أصغر — تسلسل هرمي حقيقي واحد بدل تكرار نفس الحجم 5 مرات.
                    -->
                    <TextBlock Text="العمليات الآن" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                    <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="{StaticResource RadiusLarge}"
                            Effect="{StaticResource ElevatedShadowEffect}" Margin="0,0,0,24">
                        <Grid Margin="26,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- الرقم الأهم: سيارات داخل الورشة + توزيعها على مراحل العمل -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="سيارات داخل الورشة الآن" Foreground="#9AA0A8"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeSmall}"/>
                                <TextBlock Text="7" Foreground="White"
                                           FontFamily="{StaticResource FontFamilyBase}"
                                           FontSize="42" FontWeight="Bold" Margin="0,2,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource StatusInspectionBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="فحص · 2" Foreground="#C9CDD3" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}" Margin="6,0,14,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource StatusInProgressBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="تنفيذ · 3" Foreground="#C9CDD3" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}" Margin="6,0,14,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource StatusReadyBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="جاهز · 2" Foreground="#C9CDD3" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#33FFFFFF" Margin="0,4"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="منتظرة قطع غيار" Foreground="#9AA0A8"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}"/>
                                <TextBlock Text="4" Foreground="{StaticResource AccentBrush}"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="#33FFFFFF" Margin="0,4"/>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="مسلَّمة اليوم" Foreground="#9AA0A8"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}"/>
                                <TextBlock Text="3" Foreground="White"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="5" Background="#33FFFFFF" Margin="0,4"/>

                            <StackPanel Grid.Column="6" VerticalAlignment="Center">
                                <TextBlock Text="أوامر شغل مفتوحة" Foreground="#9AA0A8"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}"/>
                                <TextBlock Text="9" Foreground="White"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="7" Background="#33FFFFFF" Margin="0,4"/>

                            <StackPanel Grid.Column="8" VerticalAlignment="Center">
                                <TextBlock Text="أوامر مكتملة اليوم" Foreground="#9AA0A8"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="{StaticResource FontSizeCaption}"/>
                                <TextBlock Text="5" Foreground="{StaticResource StatusDeliveredBrush}"
                                           FontFamily="{StaticResource FontFamilyBase}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== الملخص المالي لليوم — شكل كشف حساب مصغّر بدل 4 كروت متطابقة ===== -->
                    <TextBlock Text="الملخص المالي لليوم" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                    <Border Style="{StaticResource LedgerStripStyle}" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Style="{StaticResource LedgerCellStyle}">
                                <TextBlock Text="مبيعات اليوم" Style="{StaticResource TextMutedStyle}"/>
                                <TextBlock Text="8,650 ج.م" Style="{StaticResource TextH3Style}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BorderBrush2}" Margin="0,16"/>

                            <StackPanel Grid.Column="2" Style="{StaticResource LedgerCellStyle}">
                                <TextBlock Text="مصروفات اليوم" Style="{StaticResource TextMutedStyle}"/>
                                <TextBlock Text="2,100 ج.م" Style="{StaticResource TextH3Style}" Margin="0,4,0,0"
                                           Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="3" Background="{StaticResource BorderBrush2}" Margin="0,16"/>

                            <StackPanel Grid.Column="4" Style="{StaticResource LedgerCellStyle}">
                                <TextBlock Text="صافي اليوم" Style="{StaticResource TextMutedStyle}"/>
                                <TextBlock Text="6,550 ج.م" Style="{StaticResource TextH3Style}" Margin="0,4,0,0"
                                           Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="5" Background="{StaticResource BorderBrush2}" Margin="0,16"/>

                            <StackPanel Grid.Column="6" Style="{StaticResource LedgerCellStyle}">
                                <TextBlock Text="مستحقات على العملاء" Style="{StaticResource TextMutedStyle}"/>
                                <TextBlock Text="12,400 ج.م" Style="{StaticResource TextH3Style}" Margin="0,4,0,0"
                                           Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--
                        ===== تنبيهات — كارت واحد بصفوف بدل شارات عايمة منفصلة =====
                        قرار تصميم: الشكل القديم (بالونات Pill منفصلة عايمة) ملوش أي إطار
                        بصري يجمعها، فبتحس إنها عناصر زايدة اتحطت في الآخر. الشكل الجديد
                        كارت واحد بحدود، كل تنبيه صف بشريط لون رفيع على الجنب (بنفس منطق
                        StatTileStyle) بدل بالونة مستقلة، والفاصل بينهم خط رفيع مشترك.
                    -->
                    <TextBlock Text="تنبيهات" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                            BorderThickness="{StaticResource BorderThin}" CornerRadius="{StaticResource RadiusMedium}">
                        <StackPanel>
                            <DockPanel Margin="18,14">
                                <Border DockPanel.Dock="Right" Width="3" CornerRadius="2" Margin="0,0,14,0"
                                        Background="{StaticResource WarningBrush}"/>
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,10,0"/>
                                <TextBlock Text="3 أصناف مخزون منخفضة — راجع قسم المخزن" Style="{StaticResource TextBodyStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Height="1" Background="{StaticResource BorderBrush2}"/>
                            <DockPanel Margin="18,14">
                                <Border DockPanel.Dock="Right" Width="3" CornerRadius="2" Margin="0,0,14,0"
                                        Background="{StaticResource InfoBrush}"/>
                                <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,10,0"/>
                                <TextBlock Text="موعدان قادمان اليوم" Style="{StaticResource TextBodyStyle}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===================== شاشة "العملاء" الحقيقية الأولى (المهمة 3) ===================== -->
            <views:WorkshopCustomersView x:Name="CustomersView" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ===================== شاشة "السيارات" الحقيقية (المهمة 4) ===================== -->
            <views:WorkshopCarsView x:Name="CarsView" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ===================== شاشة "أوامر الشغل" الحقيقية (المهمة 5) ===================== -->
            <views:WorkshopWorkOrdersView x:Name="WorkOrdersView" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ===================== شاشة "استلام سيارة" الحقيقية (المهمة 6) ===================== -->
            <views:WorkshopCarIntakeView x:Name="CarIntakeView" Grid.Row="1" Visibility="Collapsed"/>

            <!-- تظهر بدل الـDashboard لما تُضغط أي قسم لسه مالوش شاشة حقيقية مبنية -->
            <Border x:Name="NotReadyView" Grid.Row="1" Background="{StaticResource AppBackgroundBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="38"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="NotReadySectionNameText" Text="—" Style="{StaticResource TextH3Style}" HorizontalAlignment="Center"/>
                    <TextBlock Text="الشاشة دي لسه مش مبنية — هتُضاف في خطوة تالية"
                               Style="{StaticResource TextMutedStyle}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
