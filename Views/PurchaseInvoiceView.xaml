        <!-- التدرجات اللونية -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A3D2F" Offset="0"/>
            <GradientStop Color="#0F5C46" Offset="0.5"/>
            <GradientStop Color="#0A3D2F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E8E5A" Offset="0"/>
            <GradientStop Color="#146B48" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrintGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#97896F" Offset="0"/>
            <GradientStop Color="#6B6156" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SearchGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3B7A8C" Offset="0"/>
            <GradientStop Color="#2C5F6B" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PurpleColor" Color="#C9972C"/>
        <SolidColorBrush x:Key="PurpleDark" Color="#A87A1E"/>
        <SolidColorBrush x:Key="OrangeColor" Color="#A8672A"/>
        <SolidColorBrush x:Key="OrangeDark" Color="#8A5220"/>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#C9972C" Offset="0"/>
            <GradientStop Color="#A87A1E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A8672A" Offset="0"/>
            <GradientStop Color="#8A5220" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="20" ShadowDepth="5" Opacity="0.15" Color="#000000"/>

        <!-- ============================================ -->
        <!-- أنماط الأزرار                                -->
        <!-- ============================================ -->

        <Style x:Key="NewButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PurpleGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PurpleDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

