            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#E7E0D2"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F2EEE6"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAF8F4"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6F3EE"/>
                    <Setter Property="BorderBrush" Value="#3D8F73"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#564C3D"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#0F5C46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- ============================================ -->
    <!-- التخطيط الرئيسي                               -->
    <!-- ============================================ -->
    <Grid Background="{StaticResource Gray100}">

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="16">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============================================ -->
                <!-- القسم الأول: رأس الصفحة                      -->
                <!-- ============================================ -->
                <Border Grid.Row="0" 
                        Background="{StaticResource HeaderGradient}"
                        CornerRadius="8,8,0,0"
                        Margin="0,0,0,12"
                        Padding="16,10"
                        Effect="{StaticResource CardShadow}">

                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="{StaticResource WhiteColor}" Width="38" Height="38" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="📥" FontSize="18" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="فاتورة مشتريات" FontSize="15" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI"/>
                                <TextBlock Text="إدارة فواتير المشتريات والموردين" FontSize="10" Foreground="#B8AC94" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Border Background="#A87A1E" CornerRadius="20" Padding="16,5" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="رقم الفاتورة:" FontSize="11" Foreground="#B8AC94" FontFamily="Segoe UI" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblInvoiceNumber" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI" Text="PIN-000001"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:Name="btnOpenSearchDialog" Content="🔍 بحث" Width="80" Style="{StaticResource SearchButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="btnNewInvoice" Content="فاتورة جديدة" Width="100" Style="{StaticResource NewButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="btnSaveInvoice" Content="حفظ الفاتورة" Width="100" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0"/>
                            <Button x:Name="btnPrintInvoice" Content="🖨️ طباعة" Width="90" Style="{StaticResource PrintButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم الثاني: معلومات الفاتورة               -->
                <!-- ============================================ -->
                <Border Grid.Row="1" 
                        Background="{StaticResource WhiteColor}"
                        CornerRadius="8"
                        Margin="0,0,0,12"
                        Padding="16,14"
                        Effect="{StaticResource CardShadow}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- العمود الأول: المورد (مع AutoComplete) -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="المورد" Style="{StaticResource FieldLabelStyle}"/>
                            <Grid>
                                <TextBox x:Name="txtSupplierSearch" 
                                         Style="{StaticResource SupplierSearchTextBox}"
                                         GotFocus="TxtSupplierSearch_GotFocus"
                                         LostFocus="TxtSupplierSearch_LostFocus"
                                         TextChanged="TxtSupplierSearch_TextChanged"
                                         PreviewKeyDown="TxtSupplierSearch_PreviewKeyDown"/>

                                <TextBlock x:Name="txtSupplierPlaceholder" 
                                           Text="🔍 ابحث عن مورد..." 
                                           FontSize="12" 
                                           Foreground="{StaticResource Gray400}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"
                                           IsHitTestVisible="False"/>

                                <Popup x:Name="popupSuppliers" 
                                       PlacementTarget="{Binding ElementName=txtSupplierSearch}" 
                                       Placement="Bottom" 
                                       StaysOpen="True" 
                                       AllowsTransparency="True"
                                       Width="{Binding ActualWidth, ElementName=txtSupplierSearch}">
                                    <Border Background="White" 
                                            BorderBrush="{StaticResource Gray200}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            MaxHeight="200"
                                            Effect="{StaticResource CardShadow}">
                                        <ListBox x:Name="lstSuppliers" 
                                                 Style="{StaticResource SupplierSuggestionListBox}"
                                                 MouseDoubleClick="LstSuppliers_MouseDoubleClick"
                                                 PreviewKeyDown="LstSuppliers_PreviewKeyDown"
                                                 SelectionChanged="LstSuppliers_SelectionChanged"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="المخزن" Style="{StaticResource FieldLabelStyle}"/>
                            <local:SmartSearchComboBox x:Name="cmbStores" DisplayMemberPath="Name" SelectedValuePath="Id" Placeholder="اكتب اسم المخزن..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="التاريخ" Style="{StaticResource FieldLabelStyle}"/>
                            <DatePicker x:Name="dpInvoiceDate"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,16,0">
                            <TextBlock Text="طريقة الدفع" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cmbPaymentMethod" SelectedIndex="0">
                                <ComboBoxItem>نقدي</ComboBoxItem>
                                <ComboBoxItem>تحويل بنكي</ComboBoxItem>
                                <ComboBoxItem>شيك</ComboBoxItem>
                                <ComboBoxItem>أجل</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="نسبة الضريبة %" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtTaxPercent" Text="0" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم الثالث: المبلغ المدفوع والمتبقي + الخزينة -->
                <!-- ============================================ -->
                <Border Grid.Row="2" 
                        Background="{StaticResource WhiteColor}"
                        CornerRadius="8"
                        Margin="0,0,0,12"
                        Padding="16,14"
                        Effect="{StaticResource CardShadow}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="pnlTreasury" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" Visibility="Collapsed">
                            <TextBlock Text="🏦 الخزينة" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource PrimaryColor}"/>
                            <local:SmartSearchComboBox x:Name="cmbTreasury" DisplayMemberPath="Name" SelectedValuePath="Id" Placeholder="اكتب اسم الخزينة..."/>
                        </StackPanel>

                        <StackPanel x:Name="pnlBank" Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" Visibility="Collapsed">
                            <TextBlock Text="🏦 الحساب البنكي" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource PrimaryColor}"/>
                            <local:SmartSearchComboBox x:Name="cmbBankAccount" SelectedValuePath="BankAccountID" Placeholder="اكتب اسم البنك..."/>
                        </StackPanel>

                        <StackPanel x:Name="pnlPaidAmount" Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="💰 المبلغ المدفوع" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtPaidAmount" Text="0.00" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="📊 المبلغ المتبقي" Style="{StaticResource FieldLabelStyle}"/>
                            <Border Background="{StaticResource DangerLight}" CornerRadius="6" Padding="12,6">
                                <TextBlock x:Name="lblRemainingAmount" Text="0.00" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerColor}" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Border x:Name="pnlCheckDetails" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Collapsed" Background="{StaticResource Gray50}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="رقم الشيك" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtCheckNumber"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="تاريخ الشيك" Style="{StaticResource FieldLabelStyle}"/>
                                    <DatePicker x:Name="dpCheckDate"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock Text="اسم البنك" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtCheckBankName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="اسم الدافع" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="txtCheckPayerName"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="pnlCreditMessage" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource WarningLight}" CornerRadius="6" Padding="12,10" Margin="0,10,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="دفع آجل" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningColor}"/>
                                <TextBlock Text="سيتم تسجيل المبلغ كدين على الشركة للمورد" FontSize="11" Foreground="{StaticResource Gray600}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم الرابع: رقم مرجعي وملاحظات              -->
                <!-- ============================================ -->
                <Border Grid.Row="3" 
                        Background="{StaticResource WhiteColor}"
                        CornerRadius="8"
                        Margin="0,0,0,12"
                        Padding="16,14"
                        Effect="{StaticResource CardShadow}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="رقم مرجعي" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtReferenceNumber"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ملاحظات" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtNotes"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم الخامس: إضافة منتج (مع AutoComplete ودعم الوحدات) -->
                <!-- ============================================ -->
                <Border Grid.Row="4" 
                        Background="{StaticResource Gray50}"
                        CornerRadius="8"
                        Margin="0,0,0,12"
                        Padding="16,14"
                        BorderBrush="{StaticResource PrimaryLight}"
                        BorderThickness="1">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="0.6*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- عمود المنتج مع AutoComplete -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="🛍️ المنتج" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,0"/>

                                    <TextBlock x:Name="lblProductStock" 
                                               Grid.Column="1"
                                               Text=""
                                               FontSize="10" 
                                               Foreground="{StaticResource SuccessColor}"
                                               FontWeight="SemiBold"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               Visibility="Collapsed"/>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <TextBox x:Name="txtProductSearch" 
                                             Style="{StaticResource ProductSearchTextBox}"
                                             GotFocus="TxtProductSearch_GotFocus"
                                             LostFocus="TxtProductSearch_LostFocus"
                                             TextChanged="TxtProductSearch_TextChanged"
                                             PreviewKeyDown="TxtProductSearch_PreviewKeyDown"/>

                                    <TextBlock x:Name="txtProductPlaceholder" 
                                               Text="🔍 ابحث عن منتج..." 
                                               FontSize="12" 
                                               Foreground="{StaticResource Gray400}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               IsHitTestVisible="False"/>

                                    <TextBox x:Name="txtProductCode" 
                                             Style="{StaticResource ProductCodeTextBox}"/>

                                    <Popup x:Name="popupProducts" 
                                           PlacementTarget="{Binding ElementName=txtProductSearch}" 
                                           Placement="Bottom" 
                                           StaysOpen="True" 
                                           AllowsTransparency="True"
                                           Width="{Binding ActualWidth, ElementName=txtProductSearch}">
                                        <Border Background="White" 
                                                BorderBrush="{StaticResource Gray200}" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                MaxHeight="200"
                                                Effect="{StaticResource CardShadow}">
                                            <ListBox x:Name="lstProducts" 
                                                     Style="{StaticResource ProductSuggestionListBox}"
                                                     MouseDoubleClick="LstProducts_MouseDoubleClick"
                                                     PreviewKeyDown="LstProducts_PreviewKeyDown"
                                                     SelectionChanged="LstProducts_SelectionChanged"/>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- ✅ عمود الوحدة -->
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="📦 الوحدة" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="cmbUnit" Height="34" FontSize="12" SelectedIndex="0" SelectionChanged="CmbUnit_SelectionChanged" MinWidth="70" MaxWidth="90"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock Text="🔢 الكمية" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtQuantity" Text="1" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                            <TextBlock Text="💲 سعر الشراء" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtUnitPrice" Text="0" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                            <TextBlock Text="🎯 الخصم %" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="txtDiscountPercent" Text="0" TextAlignment="Center"/>
                        </StackPanel>

                        <Button x:Name="btnAddProduct" Grid.Column="5" Content="إضافة منتج" Width="90" Height="36" Margin="0,20,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
                    </Grid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم السادس: جدول المنتجات                  -->
                <!-- ============================================ -->
                <Border Grid.Row="5" 
                        Background="{StaticResource WhiteColor}"
                        CornerRadius="12"
                        Margin="0,0,0,12"
                        Effect="{StaticResource CardShadow}">

                    <DataGrid x:Name="dgInvoiceItems" 
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              RowHeaderWidth="0"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              MinHeight="250"
                              GridLinesVisibility="None"
                              Background="Transparent"
                              BorderThickness="0"
                              RowHeight="48"
                              BeginningEdit="dgInvoiceItems_BeginningEdit"
                              CellEditEnding="dgInvoiceItems_CellEditEnding">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="م" Binding="{Binding SerialNumber}" Width="50" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#97896F"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Padding" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#3A332A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- ✅ عمود الوحدة -->
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" IsReadOnly="True" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Foreground" Value="#97896F"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F5C46"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="سعر الشراء" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#564C3D"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الخصم %" Binding="{Binding DiscountPercent, StringFormat={}{0:N0}}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#D97706"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="مبلغ الخصم" Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#D97706"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="120" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#1E8E5A"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" 
                                                Width="32"
                                                Height="32"
                                                Background="#FBE2E0" 
                                                Foreground="#DC2626" 
                                                BorderThickness="0" 
                                                Cursor="Hand" 
                                                Tag="{Binding}" 
                                                Click="DeleteItem_Click" 
                                                FontSize="14"
                                                FontWeight="Bold"
                                                ToolTip="حذف المنتج">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#F5CFCC"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ============================================ -->
                <!-- القسم السابع: الإجماليات                    -->
                <!-- ============================================ -->
                <Border Grid.Row="6" 
                        Background="{StaticResource WhiteColor}"
                        CornerRadius="0,0,8,8"
                        Padding="16,14"
                        Effect="{StaticResource CardShadow}"
                        Margin="0,0,0,12">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="1.4*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Gray100}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="المجموع الفرعي" FontSize="10" Foreground="{StaticResource Gray500}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblSubTotal" Text="0.00" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Gray800}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource DangerLight}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="إجمالي الخصم" FontSize="10" Foreground="{StaticResource Gray500}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblTotalDiscount" Text="0.00" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource DangerColor}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource InfoLight}" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="قيمة الضريبة" FontSize="10" Foreground="{StaticResource Gray500}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblTaxAmount" Text="0.00" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InfoColor}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Background="{StaticResource SuccessGradient}" CornerRadius="8" Padding="24,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="الإجمالي النهائي" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI" Opacity="0.85" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="lblGrandTotal" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- ============================================ -->
        <!-- نافذة البحث المنبثقة                          -->
        <!-- ============================================ -->
        <Border x:Name="SearchDialogOverlay" 
                Background="#80000000" 
                Visibility="Collapsed"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">

            <Border Background="{StaticResource WhiteColor}"
                    Width="880"
                    Height="520"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="12,12,0,0" Padding="14,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="🔍" FontSize="15" Foreground="{StaticResource WhiteColor}" Margin="0,0,8,0"/>
                                <TextBlock Text="البحث عن فواتير المشتريات" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <Button x:Name="btnCloseSearchDialog" Content="✕" Width="28" Height="28" 
                                    Background="Transparent" Foreground="{StaticResource WhiteColor}" 
                                    BorderThickness="0" FontSize="14" Cursor="Hand"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Gray50}" Padding="14,10" BorderBrush="{StaticResource Gray200}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="رقم الفاتورة" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gray600}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSearchInvoiceNumber" Height="30" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="اسم المورد" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gray600}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSearchSupplierName" Height="30" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="من تاريخ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gray600}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpFromDateSearch" Height="30" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="إلى تاريخ" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Gray600}" Margin="0,0,0,4"/>
                                <DatePicker x:Name="dpToDateSearch" Height="30" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="btnSearchInvoices" Content="بحث" Width="65" Height="30" Style="{StaticResource SearchButtonStyle}" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="14,10">
                        <Grid>
                            <DataGrid x:Name="dgSearchResults" 
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      RowHeaderWidth="0"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowHeight="38"
                                      Margin="0,0,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">

                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E6F3EE"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#24211D"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent"/>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#0F5C46"/>
                                                <Setter Property="FontSize" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="185">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="10,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="حالة الدفع" Binding="{Binding PaymentStatus}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="10"/>
                                                <Setter Property="Foreground">
                                                    <Setter.Value>
                                                        <Binding Path="PaymentStatus" Converter="{StaticResource StatusToColorConverter}"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="115">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#1E8E5A"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Width="48"
                                                            Height="28"
                                                            Background="{StaticResource PrimaryLight}" 
                                                            Foreground="{StaticResource PrimaryColor}" 
                                                            BorderThickness="0" 
                                                            Cursor="Hand" 
                                                            Tag="{Binding InvoiceID}" 
                                                            Click="ViewSelectedInvoice_Click"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            ToolTip="عرض الفاتورة"
                                                            Margin="0,0,6,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="👁️" Margin="0,0,4,0" FontSize="10"/>
                                                            <TextBlock Text="عرض" FontSize="10"/>
                                                        </StackPanel>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryColor}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <Button Width="48"
                                                            Height="28"
                                                            Background="{StaticResource DangerLight}" 
                                                            Foreground="{StaticResource DangerColor}" 
                                                            BorderThickness="0" 
                                                            Cursor="Hand" 
                                                            Tag="{Binding InvoiceID}" 
                                                            Click="DeleteInvoice_Click"
                                                            FontSize="10"
                                                            FontWeight="SemiBold"
                                                            ToolTip="حذف الفاتورة بالكامل">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="🗑️" Margin="0,0,4,0" FontSize="10"/>
                                                            <TextBlock Text="حذف" FontSize="10"/>
                                                        </StackPanel>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="Background" Value="{StaticResource DangerColor}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="lblNoSearchResults" 
                                       Text="لا توجد نتائج مطابقة لمعايير البحث"
                                       FontSize="12"
                                       Foreground="{StaticResource Gray500}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource Gray50}" Padding="10,6" CornerRadius="0,0,12,12" BorderBrush="{StaticResource Gray200}" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="lblSearchStatus" Text="أدخل معايير البحث واضغط بحث" FontSize="10" Foreground="{StaticResource Gray500}" FontFamily="Segoe UI"/>
                    </Border>
                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>