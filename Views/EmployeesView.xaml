<UserControl x:Class="RasidAccountingSystem.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Background="#F8F9FA"
             FlowDirection="RightToLeft">

    <UserControl.Resources>

        <!-- ============================================ -->
        <!-- الألوان الأساسية                             -->
        <!-- ============================================ -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#4361EE"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#3A56D4"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#E8EDFF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessDark" Color="#059669"/>
        <SolidColorBrush x:Key="SuccessLight" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="DangerDark" Color="#DC2626"/>
        <SolidColorBrush x:Key="DangerLight" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningLight" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="InfoColor" Color="#06B6D4"/>
        <SolidColorBrush x:Key="InfoLight" Color="#CFFAFE"/>
        <SolidColorBrush x:Key="WhiteColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BlackColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="Gray50" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Gray100" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Gray200" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Gray300" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Gray400" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Gray500" Color="#64748B"/>
        <SolidColorBrush x:Key="Gray600" Color="#475569"/>
        <SolidColorBrush x:Key="Gray700" Color="#334155"/>
        <SolidColorBrush x:Key="Gray800" Color="#1E293B"/>
        <SolidColorBrush x:Key="Gray900" Color="#0F172A"/>

        <!-- ============================================ -->
        <!-- التدرجات اللونية                             -->
        <!-- ============================================ -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E40AF" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================ -->
        <!-- المؤثرات البصرية                             -->
        <!-- ============================================ -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000"/>

        <!-- ============================================ -->
        <!-- أنماط الأزرار                                -->
        <!-- ============================================ -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SuccessGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SuccessDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WarningColor}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D97706"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DangerColor}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WhiteColor}"/>
            <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray300}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Gray100}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="{StaticResource WhiteColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="0,6,6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================ -->
        <!-- أنماط الجدول                                 -->
        <!-- ============================================ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Gray100}"/>
            <Setter Property="Foreground" Value="{StaticResource Gray700}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource WhiteColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gray200}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Gray50}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Gray700}"/>
            <Setter Property="FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="15">

            <!-- ================================================================ -->
            <!-- شريط العنوان -->
            <!-- ================================================================ -->
            <Border Background="{StaticResource HeaderGradient}" CornerRadius="8,8,0,0" Margin="0,0,0,12" Padding="12,10" Effect="{StaticResource CardShadow}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Background="{StaticResource WhiteColor}" Width="32" Height="32" CornerRadius="8" Margin="0,0,10,0" Opacity="0.95">
                            <TextBlock Text="👥" FontSize="16" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="إدارة الموظفين" FontSize="14" FontWeight="Bold" Foreground="{StaticResource WhiteColor}" FontFamily="Segoe UI"/>
                            <TextBlock Text="إضافة وتعديل وحذف بيانات الموظفين" FontSize="10" Foreground="#BFDBFE" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <Border Background="White" CornerRadius="16" Padding="10,3" Margin="12,0,0,0" Opacity="0.95">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="عدد الموظفين:" FontSize="10" Foreground="{StaticResource PrimaryColor}" FontFamily="Segoe UI" Margin="0,0,5,0"/>
                                <TextBlock x:Name="lblHeaderTotalCount" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryDark}" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- شريط الأدوات -->
            <!-- ================================================================ -->
            <Border Background="{StaticResource WhiteColor}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- مجموعة الأزرار (على اليمين) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAdd" Content="➕ إضافة موظف" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0" Width="120"/>
                        <Button x:Name="btnEdit" Content="✏️ تعديل" Style="{StaticResource WarningButtonStyle}" Margin="0,0,8,0" Width="90"/>
                        <Button x:Name="btnDelete" Content="🗑️ حذف" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0" Width="90"/>
                        <Button x:Name="btnRefresh" Content="⟳ تحديث" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
                    </StackPanel>

                    <!-- شريط البحث (على اليسار) -->
                    <Border Grid.Column="2" Width="280" Height="34" CornerRadius="6" Background="{StaticResource Gray100}" Padding="0" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtSearch" Grid.Column="0" VerticalContentAlignment="Center" BorderThickness="0" 
                                     Background="Transparent" FontSize="12" Padding="10,0,10,0"
                                     ToolTip="بحث بالكود أو الاسم أو القسم أو الجوال"/>
                            <Button x:Name="btnSearch" Grid.Column="1" Style="{StaticResource SearchButtonStyle}" Content="🔍" Width="50"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- بطاقات الإحصائيات -->
            <!-- ================================================================ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- البطاقة 1: إجمالي الموظفين (أقصى اليمين) -->
                <Border Grid.Column="3" Background="{StaticResource PrimaryLight}" CornerRadius="8" Padding="12,10" Margin="8,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <TextBlock Text="إجمالي الموظفين" FontSize="10" Foreground="{StaticResource Gray500}" TextAlignment="Right"/>
                            <TextBlock x:Name="lblTotalCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryColor}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- البطاقة 2: الموظفين النشطين -->
                <Border Grid.Column="2" Background="{StaticResource SuccessLight}" CornerRadius="8" Padding="12,10" Margin="8,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <TextBlock Text="الموظفين النشطين" FontSize="10" Foreground="{StaticResource Gray500}" TextAlignment="Right"/>
                            <TextBlock x:Name="lblActiveCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource SuccessColor}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="✅" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- البطاقة 3: العهود النشطة -->
                <Border Grid.Column="1" Background="{StaticResource WarningLight}" CornerRadius="8" Padding="12,10" Margin="8,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <TextBlock Text="العهد النشطة" FontSize="10" Foreground="{StaticResource Gray500}" TextAlignment="Right"/>
                            <TextBlock x:Name="lblActiveCustodyCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningColor}" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource WarningColor}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="📋" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- البطاقة 4: إجمالي العهود (أقصى اليسار) -->
                <Border Grid.Column="0" Background="{StaticResource InfoLight}" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,12,0">
                            <TextBlock Text="إجمالي العهود" FontSize="10" Foreground="{StaticResource Gray500}" TextAlignment="Right"/>
                            <TextBlock x:Name="lblTotalCustodyCount" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfoColor}" TextAlignment="Right"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8" Background="{StaticResource InfoColor}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="💰" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================================================================ -->
            <!-- جدول الموظفين - أعمدة من اليمين إلى اليسار -->
            <!-- ================================================================ -->
            <Border Background="{StaticResource WhiteColor}" CornerRadius="8" Effect="{StaticResource CardShadow}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- رأس الجدول -->
                    <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" CornerRadius="8,8,0,0" Padding="12,8">
                        <TextBlock Text="📋 قائمة الموظفين" FontSize="13" FontWeight="SemiBold" Foreground="White" TextAlignment="Right"/>
                    </Border>

                    <!-- محتوى الجدول - أعمدة مرتبة من اليمين إلى اليسار -->
                    <DataGrid Grid.Row="1" x:Name="dgEmployees" AutoGenerateColumns="False" HeadersVisibility="Column" 
                              BorderThickness="0" RowBackground="White" 
                              AlternatingRowBackground="{StaticResource Gray50}"
                              FontFamily="Segoe UI" FontSize="11"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Gray200}"
                              RowHeight="38" CanUserAddRows="False" CanUserDeleteRows="False"
                              EnableRowVirtualization="True" VirtualizingPanel.ScrollUnit="Pixel">

                        <DataGrid.Columns>
                            <!-- العمود 1 (أقصى اليمين): الكود -->
                            <DataGridTextColumn Header="الكود" Binding="{Binding EmployeeCode}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 2: الاسم بالعربية -->
                            <DataGridTextColumn Header="الاسم بالعربية" Binding="{Binding EmployeeNameAr}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource Gray800}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 3: الاسم بالإنجليزية -->
                            <DataGridTextColumn Header="الاسم بالإنجليزية" Binding="{Binding EmployeeNameEn}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 4: القسم -->
                            <DataGridTemplateColumn Header="القسم" Width="110">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PrimaryLight}" CornerRadius="12" Padding="6,3" Margin="3,0">
                                            <TextBlock Text="{Binding Department}" FontSize="10" 
                                                       Foreground="{StaticResource PrimaryColor}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- العمود 5: المنصب -->
                            <DataGridTextColumn Header="المنصب" Binding="{Binding Position}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 6: الجوال -->
                            <DataGridTextColumn Header="الجوال" Binding="{Binding Phone}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 7: البريد الإلكتروني -->
                            <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Foreground" Value="{StaticResource Gray500}"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- العمود 8 (أقصى اليسار): الإجراءات -->
                            <DataGridTemplateColumn Header="الإجراءات" Width="80" IsReadOnly="True">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource TableActionButton}" Content="✏️" Tag="{Binding EmployeeID}"
                                                    Click="EditEmployee_Click" ToolTip="تعديل"/>
                                            <Button Style="{StaticResource TableActionButton}" Content="🗑️" Tag="{Binding EmployeeID}"
                                                    Click="DeleteEmployee_Click" ToolTip="حذف" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- رسالة عدم وجود بيانات -->
                    <Border Grid.Row="2" x:Name="NoDataBorder" Background="{StaticResource Gray50}" CornerRadius="0,0,8,8" 
                            Padding="30" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center" Opacity="0.5"/>
                            <TextBlock Text="لا توجد موظفين" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{StaticResource Gray400}" Margin="0,10,0,3" HorizontalAlignment="Center"/>
                            <TextBlock Text="انقر على زر 'إضافة موظف' لإضافة أول موظف" FontSize="10" 
                                       Foreground="{StaticResource Gray400}" Opacity="0.7" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>