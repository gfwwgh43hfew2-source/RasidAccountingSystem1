<UserControl x:Class="RasidAccountingSystem.Views.WorkshopCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignWidth="1100" d:DesignHeight="700">

    <!--
        ==========================================================================
        WorkshopCustomersView.xaml — شاشة "العملاء" الحقيقية الأولى (المهمة 3)
        ==========================================================================
        هذه أول شاشة قسم حقيقية تحل محل رسالة "لسه مش جاهزة" العامة.
        البيانات هنا كلها Placeholder ثابت (بدون أي اتصال بقاعدة البيانات
        بعد) — الهدف إثبات اللغة البصرية (كروت إحصائية + جدول بسيط) بنفس
        أسلوب DashboardView بالظبط قبل ربطها بـCustomerService لاحقًا
        (نفس فكرة المهمة 13 في WORKSHOP_TASKS_CHECKLIST.txt الخاصة
        بالداشبورد).

        الجدول هنا مبني يدويًا (Border + Grid لكل صف) بنفس أسلوب باقي
        عناصر هذا المشروع التجريبي، بدون DataGrid ولا ItemsControل معقّد،
        عشان يفضل الملف بسيط وسهل المراجعة في هذه المرحلة المبكرة.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/WorkshopTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- نمط رأس عمود في جدول العملاء -->
            <Style x:Key="CustomerColHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TextCaptionStyle}">
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- نمط خلية بيانات عادية في جدول العملاء -->
            <Style x:Key="CustomerCellStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <TextBlock Text="العملاء" Style="{StaticResource TextH2Style}" Margin="0,0,0,4"/>
            <TextBlock Text="بيانات تجريبية للمعاينة فقط — سيتم ربطها بقاعدة البيانات الفعلية في خطوة تالية"
                       Style="{StaticResource TextMutedStyle}" Margin="0,0,0,16"/>

            <!-- ===== بلاطات إحصائية سريعة، بنفس أسلوب Dashboard ===== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatTileStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Width="3" CornerRadius="2" Margin="0,0,14,0"
                                Background="{StaticResource AccentBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إجمالي العملاء" Style="{StaticResource TextMutedStyle}"/>
                            <TextBlock Text="12" Style="{StaticResource TextDisplayStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatTileStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Width="3" CornerRadius="2" Margin="0,0,14,0"
                                Background="{StaticResource WarningBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="عليهم مستحقات" Style="{StaticResource TextMutedStyle}"/>
                            <TextBlock Text="5" Style="{StaticResource TextDisplayStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatTileStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Width="3" CornerRadius="2" Margin="0,0,14,0"
                                Background="{StaticResource SuccessBrush}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="عملاء جدد هذا الشهر" Style="{StaticResource TextMutedStyle}"/>
                            <TextBlock Text="3" Style="{StaticResource TextDisplayStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ===== زرار إضافة عميل (شكلي بدون منطق حقيقي بعد) ===== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Content="+ عميل جديد" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>

            <!-- ===== جدول العملاء (بيانات Placeholder ثابتة) ===== -->
            <TextBlock Text="قائمة العملاء" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,10"/>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}">
                <StackPanel>

                    <!-- رأس الجدول -->
                    <Grid Margin="20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="اسم العميل" Style="{StaticResource CustomerColHeaderStyle}"/>
                        <TextBlock Grid.Column="1" Text="رقم الهاتف" Style="{StaticResource CustomerColHeaderStyle}"/>
                        <TextBlock Grid.Column="2" Text="رقم اللوحة" Style="{StaticResource CustomerColHeaderStyle}"/>
                        <TextBlock Grid.Column="3" Text="الرصيد المستحق" Style="{StaticResource CustomerColHeaderStyle}"/>
                        <TextBlock Grid.Column="4" Text="الحالة" Style="{StaticResource CustomerColHeaderStyle}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderBrush2}"/>

                    <!-- صف 1 -->
                    <Border Background="{StaticResource SurfaceBrush}">
                        <Grid Margin="20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="أحمد محمود السيد" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="01012345678" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="ن ط ح 1234" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="3" Text="0 ج.م" Style="{StaticResource CustomerCellStyle}" Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Grid.Column="4" Style="{StaticResource StatusBadgeBaseStyle}" Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="نشط" Style="{StaticResource StatusBadgeTextStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource BorderBrush2}"/>

                    <!-- صف 2 -->
                    <Border Background="{StaticResource SurfaceAltBrush}">
                        <Grid Margin="20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="منى عبد الرحمن" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="01123456789" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="أ ب د 5678" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="3" Text="1,250 ج.م" Style="{StaticResource CustomerCellStyle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                            <Border Grid.Column="4" Style="{StaticResource StatusBadgeBaseStyle}" Background="{StaticResource WarningSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="عليه مستحقات" Style="{StaticResource StatusBadgeTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource BorderBrush2}"/>

                    <!-- صف 3 -->
                    <Border Background="{StaticResource SurfaceBrush}">
                        <Grid Margin="20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="كريم إبراهيم فتحي" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="01234567890" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="ق ل م 9012" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="3" Text="0 ج.م" Style="{StaticResource CustomerCellStyle}" Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Grid.Column="4" Style="{StaticResource StatusBadgeBaseStyle}" Background="{StaticResource SuccessSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="نشط" Style="{StaticResource StatusBadgeTextStyle}" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Height="1" Background="{StaticResource BorderBrush2}"/>

                    <!-- صف 4 -->
                    <Border Background="{StaticResource SurfaceAltBrush}">
                        <Grid Margin="20,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="سارة وليد حسن" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="1" Text="01598765432" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="2" Text="ه و ز 3456" Style="{StaticResource CustomerCellStyle}"/>
                            <TextBlock Grid.Column="3" Text="480 ج.م" Style="{StaticResource CustomerCellStyle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/>
                            <Border Grid.Column="4" Style="{StaticResource StatusBadgeBaseStyle}" Background="{StaticResource WarningSoftBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="عليه مستحقات" Style="{StaticResource StatusBadgeTextStyle}" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
