<UserControl x:Class="RasidAccountingSystem.Views.SmartSearchComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="RootControl"
             FlowDirection="RightToLeft">

    <UserControl.Resources>

        <SolidColorBrush x:Key="SscBorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="SscAccentColor" Color="#4361EE"/>
        <SolidColorBrush x:Key="SscHoverColor" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SscSelectedColor" Color="#E8EDFF"/>
        <SolidColorBrush x:Key="SscTextColor" Color="#1E293B"/>
        <SolidColorBrush x:Key="SscPlaceholderColor" Color="#94A3B8"/>

        <Style x:Key="SscSuggestionListBox" TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MaxHeight" Value="220"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SscHoverColor}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SscSelectedColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Border x:Name="MainBorder"
                Background="White"
                BorderBrush="{StaticResource SscBorderColor}"
                BorderThickness="1"
                CornerRadius="6"
                Height="38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtSearch"
                         Grid.Column="0"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="10,0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="13"
                         Foreground="{StaticResource SscTextColor}"/>

                <TextBlock x:Name="lblPlaceholder"
                           Grid.Column="0"
                           Text="اكتب للبحث..."
                           FontSize="13"
                           Foreground="{StaticResource SscPlaceholderColor}"
                           Padding="11,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <TextBlock x:Name="lblArrow"
                           Grid.Column="1"
                           Text="▾"
                           FontSize="11"
                           Foreground="{StaticResource SscPlaceholderColor}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <Popup x:Name="suggestionsPopup"
               PlacementTarget="{Binding ElementName=MainBorder}"
               Placement="Bottom"
               Width="{Binding ActualWidth, ElementName=MainBorder}"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="None">
            <Border Background="White"
                    BorderBrush="{StaticResource SscBorderColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="lstSuggestions"
                             Grid.Row="0"
                             Style="{StaticResource SscSuggestionListBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                    <TextBlock x:Name="lblNoResults"
                               Grid.Row="0"
                               Text="لا توجد نتائج مطابقة"
                               FontSize="12"
                               Foreground="{StaticResource SscPlaceholderColor}"
                               Padding="10,10"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
