<UserControl x:Class="RasidAccountingSystem.Views.ReceiptVouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="{StaticResource BackgroundColor}"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ==================== الألوان ==================== -->
        <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#3C78C8"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#285AA0"/>
        <SolidColorBrush x:Key="PrimarySoftColor" Color="#E8EEF8"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6C757D"/>
        <SolidColorBrush x:Key="BorderLightColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BackgroundGrayColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>

        <!-- ==================== التأثيرات ==================== -->
        <DropShadowEffect x:Key="ShadowSm" 
                          BlurRadius="8" 
                          ShadowDepth="1" 
                          Opacity="0.08" 
                          Direction="270"/>

        <!-- ==================== الأنماط ==================== -->

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="TextBox"
                                                   Grid.Column="0"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cairo"
                                                   FontSize="11"/>
                                <Button x:Name="DropDownButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <TextBlock Text="📅"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryColor}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Visibility="Visible"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             FontFamily="Cairo"
                                             FontSize="11"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Width="30"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <TextBlock x:Name="arrow"
                                                               Text="▼"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="▲"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Grid Width="{TemplateBinding ActualWidth}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderLightColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,1,0,0">
                                        <ScrollViewer MaxHeight="180">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SuccessColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#219A52"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundGrayColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BackgroundGrayColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- شريط تمرير محسن -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MaxWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#A0B4C8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Height="{TemplateBinding Height}"
                                                        Width="6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#7A8EAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style مخصص لـ RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryColor}"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== الشريط العلوي المبسط ==================== -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="10,8"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- العنوان والأيقونة -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="سندات القبض"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryColor}"
                               FontFamily="Cairo"/>
                </StackPanel>

                <!-- الأزرار -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnSave"
                            Content="💾 حفظ السند"
                            Style="{StaticResource SuccessButton}"
                            Margin="0,0,8,0"
                            Width="100"
                            Click="BtnSave_Click"/>
                    <Button x:Name="btnClear"
                            Content="🗑️ إلغاء"
                            Style="{StaticResource SecondaryButton}"
                            Width="80"
                            Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== المحتوى الرئيسي ==================== -->
        <ScrollViewer x:Name="MainScrollViewer" 
                      Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="MainScrollViewer_ScrollChanged">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="3.8*"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== الجزء الأيمن: نموذج إدخال سند القبض ==================== -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,8,0"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="1"
                        Effect="{StaticResource ShadowSm}">
                    <StackPanel>
                        <TextBlock Text="📝 بيانات سند القبض"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   FontFamily="Cairo"
                                   Margin="0,0,0,12"/>

                        <!-- رقم السند -->
                        <TextBlock Text="رقم السند" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtVoucherNumber"
                                 Style="{StaticResource FormTextBox}"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 Background="{StaticResource BackgroundGrayColor}"/>

                        <!-- تاريخ السند -->
                        <TextBlock Text="تاريخ السند" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="dpVoucherDate"
                                    Height="34"
                                    Margin="0,0,0,10"
                                    SelectedDate="{x:Static sys:DateTime.Now}"
                                    Style="{StaticResource FormDatePicker}"/>

                        <!-- AutoComplete للعميل -->
                        <TextBlock Text="العميل" Style="{StaticResource FormLabel}"/>
                        <Grid Margin="0,0,0,10">
                            <Border x:Name="borderCustomerSearch"
                                    CornerRadius="6"
                                    BorderBrush="{StaticResource BorderLightColor}"
                                    BorderThickness="1"
                                    Background="White">
                                <Grid>
                                    <TextBlock x:Name="txtCustomerPlaceholder"
                                               Text="ابحث باسم العميل أو الكود..."
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#999999"
                                               IsHitTestVisible="False"
                                               FontFamily="Cairo"
                                               FontSize="11"/>
                                    <TextBox x:Name="txtCustomerSearch"
                                             Style="{StaticResource FormTextBox}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             FontFamily="Cairo"
                                             FontSize="11"
                                             TextChanged="TxtCustomerSearch_TextChanged"
                                             GotFocus="TxtCustomerSearch_GotFocus"
                                             LostFocus="TxtCustomerSearch_LostFocus"
                                             KeyDown="TxtCustomerSearch_KeyDown"
                                             PreviewKeyDown="TxtCustomerSearch_PreviewKeyDown"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="popupCustomers"
                                   PlacementTarget="{Binding ElementName=txtCustomerSearch}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderLightColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="{Binding ActualWidth, ElementName=txtCustomerSearch}">
                                    <ListBox x:Name="lstCustomers"
                                             MaxHeight="180"
                                             Background="White"
                                             BorderThickness="0"
                                             Focusable="True"
                                             IsTabStop="True"
                                             MouseUp="LstCustomers_MouseUp"
                                             KeyDown="LstCustomers_KeyDown"
                                             PreviewKeyDown="LstCustomers_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,5"
                                                        BorderBrush="{StaticResource BorderLightColor}"
                                                        BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="Cairo"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                                            <TextBlock Text="{Binding Code}"
                                                                       FontFamily="Cairo"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                                       Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Background="{StaticResource BackgroundGrayColor}"
                                                                CornerRadius="4"
                                                                Padding="6,3"
                                                                VerticalAlignment="Center">
                                                            <TextBlock FontFamily="Cairo"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource TextPrimaryColor}"
                                                                       Text="{Binding CurrentBalance, StringFormat=رصيد: {0:N2}}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- عرض الرصيد الحالي -->
                        <Border x:Name="borderCustomerBalance"
                                Background="{StaticResource BackgroundGrayColor}"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,3,0,10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="الرصيد الحالي للعميل"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               FontFamily="Cairo"/>
                                    <TextBlock x:Name="lblCustomerBalance"
                                               Text="0.00"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               FontFamily="Cairo"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        x:Name="borderBalanceStatus"
                                        Background="{StaticResource InfoColor}"
                                        CornerRadius="12"
                                        Padding="6,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="lblCustomerBalanceStatus"
                                               Text="متزن"
                                               FontSize="9"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               FontFamily="Cairo"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- AutoComplete للفاتورة -->
                        <TextBlock Text="رقم الفاتورة (اختياري)" Style="{StaticResource FormLabel}"/>
                        <Grid Margin="0,0,0,10">
                            <Border x:Name="borderInvoiceSearch"
                                    CornerRadius="6"
                                    BorderBrush="{StaticResource BorderLightColor}"
                                    BorderThickness="1"
                                    Background="White">
                                <Grid>
                                    <TextBlock x:Name="txtInvoicePlaceholder"
                                               Text="ابحث برقم الفاتورة..."
                                               Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#999999"
                                               IsHitTestVisible="False"
                                               FontFamily="Cairo"
                                               FontSize="11"
                                               Visibility="Visible"/>
                                    <TextBox x:Name="txtInvoiceSearch"
                                             Style="{StaticResource FormTextBox}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="8,0"
                                             VerticalContentAlignment="Center"
                                             FontFamily="Cairo"
                                             FontSize="11"
                                             TextChanged="TxtInvoiceSearch_TextChanged"
                                             GotFocus="TxtInvoiceSearch_GotFocus"
                                             LostFocus="TxtInvoiceSearch_LostFocus"
                                             KeyDown="TxtInvoiceSearch_KeyDown"
                                             PreviewKeyDown="TxtInvoiceSearch_PreviewKeyDown"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="popupInvoices"
                                   PlacementTarget="{Binding ElementName=txtInvoiceSearch}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderLightColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Width="{Binding ActualWidth, ElementName=txtInvoiceSearch}">
                                    <ListBox x:Name="lstInvoices"
                                             MaxHeight="180"
                                             Background="White"
                                             BorderThickness="0"
                                             Focusable="True"
                                             IsTabStop="True"
                                             MouseUp="LstInvoices_MouseUp"
                                             KeyDown="LstInvoices_KeyDown"
                                             PreviewKeyDown="LstInvoices_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,5"
                                                        BorderBrush="{StaticResource BorderLightColor}"
                                                        BorderThickness="0,0,0,1">
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontFamily="Cairo"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextPrimaryColor}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- المبلغ -->
                        <TextBlock Text="المبلغ" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtAmount"
                                 Style="{StaticResource FormTextBox}"
                                 Margin="0,0,0,10"
                                 TextChanged="TxtAmount_TextChanged"/>

                        <!-- الرصيد المتوقع -->
                        <Border x:Name="borderBalanceAfter"
                                Background="#E8F5E9"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,3,0,10"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="الرصيد المتوقع بعد التحصيل"
                                           FontSize="10"
                                           Foreground="#2E7D32"
                                           FontFamily="Cairo"/>
                                <TextBlock x:Name="lblBalanceAfter"
                                           Text="0.00"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessColor}"
                                           FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>

                        <!-- ComboBox لطريقة السداد -->
                        <TextBlock Text="طريقة السداد" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cboPaymentMethod"
                                  Style="{StaticResource FormComboBox}"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectionChanged="CboPaymentMethod_SelectionChanged"
                                  TextBoxBase.TextChanged="CboPaymentMethod_TextChanged"
                                  DropDownOpened="CboPaymentMethod_DropDownOpened"
                                  KeyDown="CboPaymentMethod_KeyDown"
                                  LostFocus="CboPaymentMethod_LostFocus"/>

                        <!-- رقم الشيك -->
                        <StackPanel x:Name="pnlCheckNumber" Visibility="Collapsed">
                            <TextBlock Text="رقم الشيك" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="txtCheckNumber"
                                     Style="{StaticResource FormTextBox}"
                                     Margin="0,0,0,10"/>
                        </StackPanel>

                        <!-- ComboBox للخزينة -->
                        <TextBlock Text="إيداع في" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="cboTreasury"
                                  Style="{StaticResource FormComboBox}"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CboTreasury_SelectionChanged"
                                  TextBoxBase.TextChanged="CboTreasury_TextChanged"
                                  DropDownOpened="CboTreasury_DropDownOpened"
                                  KeyDown="CboTreasury_KeyDown"
                                  LostFocus="CboTreasury_LostFocus"/>

                        <!-- البيان -->
                        <TextBlock Text="البيان" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtDescription"
                                 Style="{StaticResource FormTextBox}"
                                 Height="55"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ==================== الجزء الأيسر: قائمة سندات القبض ==================== -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="0"
                        Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="1"
                        Effect="{StaticResource ShadowSm}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- عنوان القسم والفلتر -->
                        <Border Grid.Row="0" 
                                Background="{StaticResource BackgroundGrayColor}"
                                Padding="15,12"
                                CornerRadius="10,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="📋 سندات القبض المسجلة" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryColor}"
                                           FontFamily="Cairo"/>

                                <WrapPanel Grid.Column="1">
                                    <RadioButton x:Name="rbAll"
                                                 Content="الكل"
                                                 IsChecked="True"
                                                 GroupName="Filter"
                                                 Checked="Filter_Checked"/>
                                    <RadioButton x:Name="rbToday"
                                                 Content="اليوم"
                                                 GroupName="Filter"
                                                 Checked="Filter_Checked"/>
                                    <RadioButton x:Name="rbThisWeek"
                                                 Content="هذا الأسبوع"
                                                 GroupName="Filter"
                                                 Checked="Filter_Checked"/>
                                    <RadioButton x:Name="rbThisMonth"
                                                 Content="هذا الشهر"
                                                 GroupName="Filter"
                                                 Checked="Filter_Checked"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- الملخص -->
                        <Border Grid.Row="1"
                                Background="{StaticResource BackgroundGrayColor}"
                                CornerRadius="0"
                                Padding="15,12"
                                Margin="0,0,0,0"
                                BorderBrush="{StaticResource BorderLightColor}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="إجمالي المبلغ المحصل"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               FontFamily="Cairo"/>
                                    <TextBlock x:Name="lblTotalAmount"
                                               Text="0.00"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessColor}"
                                               FontFamily="Cairo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="عدد السندات"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               FontFamily="Cairo"/>
                                    <TextBlock x:Name="lblVouchersCount"
                                               Text="0"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryColor}"
                                               FontFamily="Cairo"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- جدول البيانات بتصميم مطابق لـ TreasuryView -->
                        <DataGrid x:Name="dgVouchers" 
                                  Grid.Row="2"
                                  MinHeight="350"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  HeadersVisibility="Column" 
                                  GridLinesVisibility="None"
                                  RowHeight="50" 
                                  BorderThickness="0"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource SurfaceColor}"
                                  AlternatingRowBackground="#F8FAFC"
                                  RowBackground="{StaticResource SurfaceColor}">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontFamily" Value="Cairo"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Height" Value="48"/>
                                    <Setter Property="Padding" Value="15,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontFamily" Value="Cairo"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="15,0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="🏷️ رقم السند" 
                                                    Binding="{Binding VoucherNumber}" 
                                                    Width="*"
                                                    MinWidth="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="📅 التاريخ" 
                                                    Binding="{Binding PaymentDate}" 
                                                    Width="*"
                                                    MinWidth="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="👤 العميل" 
                                                    Binding="{Binding CustomerName}" 
                                                    Width="*"
                                                    MinWidth="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="💰 المبلغ" 
                                                    Binding="{Binding Amount, StringFormat=N2}" 
                                                    Width="*"
                                                    MinWidth="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="💳 طريقة السداد" 
                                                    Binding="{Binding PaymentMethodDisplay}" 
                                                    Width="*"
                                                    MinWidth="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="🏦 الخزينة" 
                                                    Binding="{Binding TreasuryName}" 
                                                    Width="*"
                                                    MinWidth="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="🖨️" 
                                                        Width="50"
                                                        MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🖨️"
                                                    Width="34"
                                                    Height="34"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="PrintVoucher_Click"
                                                    Tag="{Binding PaymentID}"
                                                    ToolTip="طباعة السند"
                                                    Style="{StaticResource IconButton}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="🗑️" 
                                                        Width="50"
                                                        MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️"
                                                    Width="34"
                                                    Height="34"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Click="DeleteVoucher_Click"
                                                    Tag="{Binding PaymentID}"
                                                    ToolTip="حذف السند"
                                                    Style="{StaticResource IconButton}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- رسالة عدم وجود بيانات -->
                        <Border Grid.Row="2"
                                Background="#F8FAFC"
                                CornerRadius="12"
                                Padding="40"
                                x:Name="lblNoData"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                <TextBlock Text="لا توجد سندات قبض مسجلة"
                                           FontSize="14"
                                           Foreground="#64748B"
                                           HorizontalAlignment="Center"
                                           FontFamily="Cairo"/>
                                <TextBlock Text="يمكنك إضافة سند قبض جديد من النموذج الأيمن"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"
                                           FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>