<Window x:Class="RasidAccountingSystem.Views.FirstRunSetupView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الإعداد الأولي - نظام رصيد المحاسبي"
        Height="620" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- ==================== الألوان ==================== -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#1A2980"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#26D0CE"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#28A745"/>
        <SolidColorBrush x:Key="DangerColor" Color="#DC3545"/>
        <SolidColorBrush x:Key="TextDark" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextLight" Color="#7F8C8D"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BackgroundLight" Color="#F8F9FA"/>

        <!-- ==================== التدرجات ==================== -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A2980" Offset="0"/>
            <GradientStop Color="#26D0CE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#28A745" Offset="0"/>
            <GradientStop Color="#20C997" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#218838" Offset="0"/>
            <GradientStop Color="#1BA87E" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== الظلال ==================== -->
        <DropShadowEffect x:Key="WindowShadow" 
                          BlurRadius="30" 
                          ShadowDepth="0" 
                          Opacity="0.3"
                          Color="Black"/>

        <DropShadowEffect x:Key="ButtonShadow" 
                          BlurRadius="10" 
                          ShadowDepth="3" 
                          Opacity="0.3"
                          Color="#28A745"
                          Direction="270"/>

        <DropShadowEffect x:Key="InputShadow" 
                          BlurRadius="8" 
                          ShadowDepth="2" 
                          Opacity="0.05"
                          Color="Black"/>

        <!-- ==================== أنماط حقول الإدخال ==================== -->

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect" Value="{StaticResource InputShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEF3F2"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ==================== النافذة الرئيسية ==================== -->
    <Border Background="White" 
            CornerRadius="20" 
            Margin="10"
            Effect="{StaticResource WindowShadow}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== الهيدر ==================== -->
            <Border Grid.Row="0" 
                    Background="{StaticResource HeaderGradient}"
                    CornerRadius="20,20,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="🏦" 
                                   FontSize="32" 
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Emoji"/>
                        <TextBlock Text="الإعداد الأولي" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="White"
                                   FontFamily="Cairo"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="0" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Center">
                        <TextBlock Text="إنشاء حساب المدير الرئيسي" 
                                   FontSize="12" 
                                   Foreground="#E0E0E0"
                                   FontFamily="Cairo"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== المحتوى ==================== -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Border Padding="25,20,25,25">
                    <StackPanel>

                        <TextBlock Text="🔐" 
                                   FontSize="28" 
                                   FontFamily="Segoe UI Emoji"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="مرحباً بك في نظام رصيد المحاسبي" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextDark}"
                                   FontFamily="Cairo"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="هذه هي المرة الأولى لتشغيل البرنامج" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextLight}"
                                   FontFamily="Cairo"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- ==================== اسم المستخدم ==================== -->
                        <TextBlock Text="اسم المستخدم 👤"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtUsername" 
                                 Style="{StaticResource FormTextBox}"/>

                        <!-- ==================== كلمة المرور مع زر إظهار/إخفاء ==================== -->
                        <TextBlock Text="كلمة المرور 🔒"
                                   Style="{StaticResource FormLabel}"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <PasswordBox x:Name="txtPassword" 
                                         Grid.Column="0"
                                         Height="42"
                                         Padding="15,0"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         Background="White"
                                         BorderBrush="{StaticResource BorderColor}"
                                         BorderThickness="1"
                                         Effect="{StaticResource InputShadow}"
                                         FontFamily="Cairo"
                                         FontSize="13">
                                <PasswordBox.Template>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsFocused" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryColor}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                                <Setter Property="Effect" Value="{x:Null}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </PasswordBox.Template>
                            </PasswordBox>

                            <Button x:Name="btnTogglePassword"
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Content>
                                    <TextBlock x:Name="togglePasswordIcon" 
                                               Text="👁" 
                                               FontSize="18" 
                                               Foreground="#7F8C8D"/>
                                </Button.Content>
                            </Button>
                        </Grid>

                        <!-- ملاحظات -->
                        <Border Background="#F0FDF4" 
                                CornerRadius="8" 
                                Padding="10" 
                                Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="يجب أن تكون كلمة المرور 6 أحرف على الأقل" 
                                           FontSize="11" 
                                           Foreground="#166534"
                                           FontFamily="Cairo"/>
                                <TextBlock Text="ℹ️" FontSize="12" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ==================== الأزرار ==================== -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center" 
                                    Margin="0,5,0,0">
                            <Button x:Name="btnCreate" 
                                    Content="إنشاء حساب"
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button x:Name="btnCancel" 
                                    Content="إلغاء"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="15,0,0,0"/>
                        </StackPanel>

                        <!-- ==================== رسالة الخطأ ==================== -->
                        <Border x:Name="ErrorBorder"
                                Background="#FEF3F2"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,15,0,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="txtError"
                                           Foreground="#DC3545"
                                           FontFamily="Cairo"
                                           FontSize="11"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="⚠" FontSize="11" Foreground="#DC3545" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>