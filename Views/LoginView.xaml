<Window x:Class="RasidAccountingSystem.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تسجيل الدخول - نظام رصيد المحاسبي المتكامل"
        Height="650" 
        Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Window.Resources>

        <!-- ==================== الألوان العالمية ==================== -->
        <Color x:Key="PrimaryGradientStart">#1A2980</Color>
        <Color x:Key="PrimaryGradientEnd">#26D0CE</Color>

        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorLight" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ErrorDark" Color="#EF4444"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2563EB"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>

        <!-- ==================== التدرج اللوني للشريط الجانبي ==================== -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== التدرج اللوني للشريط الجانبي (نسخة أفقية للزر) ==================== -->
        <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0"/>
            <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2A3980" Offset="0"/>
            <GradientStop Color="#36D0CE" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== الظلال ==================== -->
        <DropShadowEffect x:Key="WindowShadow" 
                          BlurRadius="40" 
                          ShadowDepth="0" 
                          Opacity="0.25"
                          Color="#000000"/>

        <DropShadowEffect x:Key="CardShadow" 
                          BlurRadius="30" 
                          ShadowDepth="0" 
                          Opacity="0.08" 
                          Color="#000000"/>

        <DropShadowEffect x:Key="ButtonShadow" 
                          BlurRadius="15" 
                          ShadowDepth="3" 
                          Opacity="0.3"
                          Color="#1A2980"
                          Direction="270"/>

        <DropShadowEffect x:Key="InputShadow" 
                          BlurRadius="8" 
                          ShadowDepth="2" 
                          Opacity="0.05"
                          Color="#000000"/>

        <!-- ==================== الأنيميشن ==================== -->

        <!-- أنيميشن التلاشي عند تحميل الصفحة -->
        <Storyboard x:Key="PageFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0" 
                             To="1" 
                             Duration="0:0:0.4" 
                             DecelerationRatio="0.8"/>
        </Storyboard>

        <!-- أنيميشن الانزلاق للأعلى -->
        <Storyboard x:Key="ContentSlideUp">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" 
                             From="30" 
                             To="0" 
                             Duration="0:0:0.35" 
                             DecelerationRatio="0.7"/>
        </Storyboard>

        <!-- ==================== الأنماط ==================== -->

        <!-- زر إظهار/إخفاء كلمة المرور -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر تسجيل الدخول الرئيسي -->
        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Effect="{StaticResource ButtonShadow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0"/>
                                    <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2A3980" Offset="0"/>
                                            <GradientStop Color="#36D0CE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر ثانوي (رابط) -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- حقل إدخال TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Effect" Value="{StaticResource InputShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- حقل كلمة المرور -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{StaticResource InputShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}" 
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- قائمة المستخدمين ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Effect" Value="{StaticResource InputShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="toggleBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="12">
                                            <Path x:Name="Arrow"
                                                  Data="M0,0 L4,4 L8,0"
                                                  Fill="#64748B"
                                                  HorizontalAlignment="Right"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M0,4 L4,0 L8,4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              HorizontalAlignment="Stretch"
                                              IsHitTestVisible="False"
                                              Margin="14,0,30,0"
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ToggleButton}"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource SurfaceColor}"
                                        BorderBrush="{StaticResource BorderLight}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MaxHeight="200"
                                        Effect="{StaticResource CardShadow}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="ToggleButton" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط عناصر ComboBox -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                CornerRadius="8" 
                                Margin="4,2">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تسمية الحقل -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="110"/>
        </Style>

        <!-- رسالة الخطأ -->
        <Style x:Key="ErrorStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorDark}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- شريط التمرير الرفيع -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#CBD5E1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Row="0" Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       Grid.Row="0" 
                                       Grid.Column="1" 
                                       Style="{StaticResource ThinScrollBar}" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ==================== النافذة الرئيسية ==================== -->
    <Border Background="White" 
            CornerRadius="24" 
            Margin="10" 
            Effect="{StaticResource WindowShadow}">

        <Border.RenderTransform>
            <TranslateTransform/>
        </Border.RenderTransform>

        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource PageFadeIn}"/>
                <BeginStoryboard Storyboard="{StaticResource ContentSlideUp}"/>
            </EventTrigger>
        </Border.Triggers>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== الجانب الأيسر - العلامة التجارية ==================== -->
            <Border Grid.Column="0" 
                    CornerRadius="24,0,0,24" 
                    Background="{StaticResource SidebarGradient}">

                <StackPanel VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Margin="25">

                    <!-- ==================== الشعار مع Viewport3D بحجم أكبر ==================== -->
                    <Viewport3D x:Name="LogoViewport3D" 
                                Width="180" 
                                Height="180"
                                Margin="0,0,0,10">

                        <!-- ==================== الكاميرا ==================== -->
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="LogoCamera"
                                               Position="0, 0, 5"
                                               LookDirection="0, 0, -1"
                                               UpDirection="0, 1, 0"
                                               FieldOfView="45"/>
                        </Viewport3D.Camera>

                        <!-- ==================== الإضاءة ==================== -->
                        <Viewport3D.Children>

                            <!-- ====== إضاءة أمامية بيضاء ====== -->
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <DirectionalLight Color="White" Direction="0, 0, -1"/>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- ====== إضاءة جانبية سماوية ====== -->
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <DirectionalLight Color="#26D0CE" Direction="-1, -1, -1"/>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- ====== إضاءة خلفية زرقاء ====== -->
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <DirectionalLight Color="#1A2980" Direction="1, 1, -1"/>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- ====== إضاءة علوية خفيفة ====== -->
                            <ModelVisual3D>
                                <ModelVisual3D.Content>
                                    <DirectionalLight Color="White" Direction="0, -1, 0"/>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- ==================== المجسم ثلاثي الأبعاد ==================== -->
                            <ModelVisual3D x:Name="LogoModelVisual3D">

                                <ModelVisual3D.Transform>
                                    <Transform3DGroup>
                                        <RotateTransform3D x:Name="LogoRotateTransform3D">
                                            <RotateTransform3D.Rotation>
                                                <AxisAngleRotation3D x:Name="LogoAxisRotation3D"
                                                                      Axis="0, 1, 0"
                                                                      Angle="0"/>
                                            </RotateTransform3D.Rotation>
                                        </RotateTransform3D>
                                        <RotateTransform3D x:Name="LogoTiltTransform3D">
                                            <RotateTransform3D.Rotation>
                                                <AxisAngleRotation3D x:Name="LogoTiltAxisRotation"
                                                                      Axis="1, 0, 0"
                                                                      Angle="0"/>
                                            </RotateTransform3D.Rotation>
                                        </RotateTransform3D>
                                    </Transform3DGroup>
                                </ModelVisual3D.Transform>

                                <ModelVisual3D.Content>
                                    <GeometryModel3D>

                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D x:Name="LogoMesh"
                                                             Positions="-1.3, -1.3, 0  1.3, -1.3, 0  1.3, 1.3, 0  -1.3, 1.3, 0"
                                                             TextureCoordinates="0, 1  1, 1  1, 0  0, 0"
                                                             TriangleIndices="0, 1, 2  0, 2, 3"/>
                                        </GeometryModel3D.Geometry>

                                        <!-- ====== المادة الأمامية (الصورة) ====== -->
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial x:Name="LogoMaterial">
                                                <DiffuseMaterial.Brush>
                                                    <ImageBrush x:Name="LogoImageBrush" 
                                                                 Stretch="Uniform"/>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>

                                        <!-- ====== المادة الخلفية (نفس الصورة) ====== -->
                                        <GeometryModel3D.BackMaterial>
                                            <DiffuseMaterial x:Name="LogoBackMaterial">
                                                <DiffuseMaterial.Brush>
                                                    <ImageBrush x:Name="LogoBackImageBrush" 
                                                                 Stretch="Uniform"/>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.BackMaterial>

                                    </GeometryModel3D>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                            <!-- ==================== حلقة ضوئية حول المجسم ==================== -->
                            <ModelVisual3D>
                                <ModelVisual3D.Transform>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="RingRotation"
                                                                  Axis="0, 0, 1"
                                                                  Angle="0"/>
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                </ModelVisual3D.Transform>

                                <ModelVisual3D.Content>
                                    <GeometryModel3D>
                                        <GeometryModel3D.Geometry>
                                            <MeshGeometry3D x:Name="RingMesh"
                                                             Positions="0, 1.7, 0  1.7, 0, 0  0, -1.7, 0  -1.7, 0, 0"
                                                             TriangleIndices="0,1,2  0,2,3"
                                                             TextureCoordinates="0,1  1,1  1,0  0,0"/>
                                        </GeometryModel3D.Geometry>
                                        <GeometryModel3D.Material>
                                            <DiffuseMaterial>
                                                <DiffuseMaterial.Brush>
                                                    <SolidColorBrush Color="#26D0CE" Opacity="0.3"/>
                                                </DiffuseMaterial.Brush>
                                            </DiffuseMaterial>
                                        </GeometryModel3D.Material>
                                    </GeometryModel3D>
                                </ModelVisual3D.Content>
                            </ModelVisual3D>

                        </Viewport3D.Children>
                    </Viewport3D>

                    <TextBlock Text="نظام رصيد" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               FontFamily="Cairo" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8"/>

                    <TextBlock Text="المحاسبي المتكامل" 
                               FontSize="14" 
                               Foreground="#E0E8F0" 
                               FontFamily="Cairo" 
                               HorizontalAlignment="Center" 
                               TextAlignment="Center" 
                               Margin="0,0,0,30"/>

                    <Border Width="40" 
                            Height="2" 
                            Background="White" 
                            Opacity="0.2" 
                            CornerRadius="1" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,25"/>

                    <StackPanel>
                        <TextBlock Text="✓ إدارة حسابات متكاملة" 
                                   FontSize="12" 
                                   Foreground="#E0E8F0" 
                                   FontFamily="Cairo" 
                                   Margin="0,5"/>
                        <TextBlock Text="✓ فواتير إلكترونية" 
                                   FontSize="12" 
                                   Foreground="#E0E8F0" 
                                   FontFamily="Cairo" 
                                   Margin="0,5"/>
                        <TextBlock Text="✓ بنوك وخزينة رقمية" 
                                   FontSize="12" 
                                   Foreground="#E0E8F0" 
                                   FontFamily="Cairo" 
                                   Margin="0,5"/>
                        <TextBlock Text="✓ تقارير مالية فورية" 
                                   FontSize="12" 
                                   Foreground="#E0E8F0" 
                                   FontFamily="Cairo" 
                                   Margin="0,5"/>
                        <TextBlock Text="✓ أمان وحماية متقدمة" 
                                   FontSize="12" 
                                   Foreground="#E0E8F0" 
                                   FontFamily="Cairo" 
                                   Margin="0,5"/>
                    </StackPanel>

                    <TextBlock Text="الإصدار 3.0.0"
                               FontSize="10"
                               Foreground="#A0AEC0"
                               FontFamily="Cairo"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0"
                               Opacity="0.6"/>
                </StackPanel>
            </Border>

            <!-- ==================== الجانب الأيمن - نموذج الدخول ==================== -->
            <Border Grid.Column="1" 
                    Background="White" 
                    CornerRadius="0,24,24,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled" 
                              Style="{StaticResource ThinScrollViewer}">

                    <StackPanel Margin="45,55,45,50">

                        <!-- العنوان -->
                        <TextBlock Text="مرحباً بعودتك" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}" 
                                   FontFamily="Cairo" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,6"/>

                        <TextBlock Text="يسعدنا رؤيتك مرة أخرى" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontFamily="Cairo" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,40"/>

                        <!-- ==================== صف اسم المستخدم ==================== -->
                        <Grid Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="👤 اسم المستخدم"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,18,0" 
                                       Width="120"/>

                            <ComboBox Grid.Column="1" 
                                      x:Name="cmbUsername"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Width="280"
                                      Margin="20,0,0,0"/>
                        </Grid>

                        <!-- ==================== صف كلمة المرور ==================== -->
                        <Grid Margin="0,0,0,25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="🔒 كلمة المرور"
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,18,0"/>

                            <PasswordBox Grid.Column="1" 
                                         x:Name="txtPasswordHidden"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Left"
                                         Width="280"
                                         Margin="30,0,0,0"/>

                            <Button x:Name="btnTogglePassword"
                                    Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Content="👁"
                                    Margin="10,0,0,0"/>
                        </Grid>

                        <!-- ==================== خيارات إضافية ==================== -->
                        <Grid Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="btnForgotPassword"
                                    Grid.Column="0"
                                    Style="{StaticResource LinkButton}"
                                    Content="🔐 نسيت كلمة المرور؟"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"/>

                            <Button x:Name="btnCreateAccount"
                                    Grid.Column="1"
                                    Style="{StaticResource LinkButton}"
                                    Content="➕ إنشاء حساب جديد"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"/>
                        </Grid>

                        <!-- ==================== زر تسجيل الدخول الرئيسي ==================== -->
                        <Button x:Name="btnLogin" 
                                Content="🔑  دخول" 
                                Style="{StaticResource LoginButton}" 
                                HorizontalAlignment="Center" 
                                Margin="0,5,0,20"/>

                        <!-- ==================== رسالة الخطأ ==================== -->
                        <Border x:Name="ErrorBorder" 
                                Background="{StaticResource ErrorLight}" 
                                CornerRadius="12" 
                                Padding="14" 
                                Margin="0,20,0,0" 
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center">
                                <TextBlock Text="⚠" 
                                           FontSize="14" 
                                           Foreground="{StaticResource ErrorDark}" 
                                           Margin="0,0,10,0"/>
                                <TextBlock x:Name="txtError" 
                                           Style="{StaticResource ErrorStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- ==================== زر الإغلاق ==================== -->
                        <Button x:Name="btnClose" 
                                Width="36" 
                                Height="36" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Top" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                Foreground="{StaticResource TextMuted}" 
                                FontSize="16" 
                                FontFamily="Segoe UI" 
                                Cursor="Hand" 
                                Content="✕" 
                                Margin="0,-45,-30,0">
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="Foreground.Color" 
                                                            To="#EF4444" 
                                                            Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetProperty="Foreground.Color" 
                                                            To="#94A3B8" 
                                                            Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <!-- حقوق الملكية -->
                        <TextBlock Text="© 2025 نظام رصيد المحاسبي. جميع الحقوق محفوظة" 
                                   FontSize="10" 
                                   Foreground="{StaticResource TextMuted}" 
                                   FontFamily="Cairo" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,30,0,0" 
                                   Opacity="0.5"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>