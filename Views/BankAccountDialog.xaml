<Window x:Class="RasidAccountingSystem.Views.BankAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حساب بنكي"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F5F7FA"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryColor" Color="#4361EE"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#3A56D4"/>
        <SolidColorBrush x:Key="TextDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="TextLight" Color="#64748B"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="Gray100" Color="#F1F5F9"/>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Gray100}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- الترويسة -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏦" FontSize="22" Margin="0,0,10,0"/>
                <TextBlock x:Name="lblDialogTitle" Text="إضافة حساب بنكي جديد" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- النموذج -->
        <ScrollViewer Grid.Row="1" Margin="24,20,24,10" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="كود الحساب" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtBankCode" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="اسم البنك بالعربية *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtBankNameAr" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="اسم البنك بالإنجليزية" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtBankNameEn" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="رقم الحساب *" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtAccountNumber" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="رقم الآيبان (IBAN)" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtIBAN" Style="{StaticResource FormTextBox}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم الفرع" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtBranchName" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="كود الفرع" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtBranchCode" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="السويفت كود (SWIFT)" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtSwiftCode" Style="{StaticResource FormTextBox}"/>

                <TextBlock x:Name="lblOpeningBalance" Text="الرصيد الافتتاحي" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtOpeningBalance" Style="{StaticResource FormTextBox}" Text="0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم المسؤول" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtContactPerson" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="رقم الهاتف" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="txtPhone" Style="{StaticResource FormTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="البريد الإلكتروني" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtEmail" Style="{StaticResource FormTextBox}"/>

                <TextBlock Text="ملاحظات" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="txtNotes" Style="{StaticResource FormTextBox}" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,8"/>

            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="btnSave" Content="حفظ" Width="120" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                <Button x:Name="btnCancel" Content="إلغاء" Width="120" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
