<UserControl x:Class="RasidAccountingSystem.Views.WorkshopSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignWidth="280" d:DesignHeight="800">

    <!--
        ==========================================================================
        WorkshopSidebar.xaml — هيكل القائمة الجانبية النهائي لبرنامج "الورشة"
        ==========================================================================
        هذا يوزركنترول مستقل تمامًا — غير مربوط بـ MainWindow.xaml الحالي بعد.
        الهدف من هذه الخطوة: الاتفاق على شكل وترتيب الأقسام وأيقوناتها فقط،
        قبل ما نستثمر وقت في ربطها فعليًا بتبديل محتوى الشاشة الرئيسية
        (هذا سيكون خطوة لاحقة منفصلة بعد موافقتك على الشكل).

        الأقسام مرتبة حسب دورة عمل السيارة داخل الورشة (نفس الترتيب المطلوب):
        الرئيسية → العملاء → السيارات → استلام سيارة → أوامر الشغل →
        الفنيون → المخزن → الموردون → الحسابات → المصروفات → الفواتير →
        التقارير → الإعدادات.

        الأيقونات هنا Segoe Fluent Icons (Windows 11) مع سقوط تلقائي لـ
        Segoe MDL2 Assets (Windows 10) — خطوط أيقونات نظامية مثبَّتة فعليًا
        على أي جهاز ويندوز حديث، بدون أي حاجة لتحميل مكتبة SVG أو اتصال
        إنترنت. كل زرار بياخد كود الأيقونة (Glyph) عبر خاصية Tag، بالظبط
        زي ما كان بيحصل مع الرموز النصية القديمة، فمفيش أي تغيير في هيكل
        الملف نفسه — بس استبدال قيمة Tag + إضافة FontFamily للأيقونة.

        ⚠️ كودات الأيقونات دي متأكد منها بدرجات ثقة متفاوتة (مفيش بيئة
        رسومية هنا لعرض WPF فعليًا والتأكد بصريًا). لو أي أيقونة ظهرت
        عندك فاضية أو مربع/رمز غريب بدل الشكل المتوقع، قولّي بالظبط أي
        زرار وأنا أستبدل الكود بتاعه فورًا — نفس أسلوب "اختبر وبلّغ" المتفق
        عليه في PROJECT_PROGRESS.txt.
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/WorkshopTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- زرار عنصر رئيسي في القائمة الجانبية -->
            <Style x:Key="SidebarItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#C9CDD3"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Margin" Value="12,2,12,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <DockPanel Margin="14,0" LastChildFill="True">
                                    <TextBlock x:Name="IconText"
                                               Text="{Binding Path=(Tag), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Width="26"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               DockPanel.Dock="Right"/>
                                    <TextBlock x:Name="LabelText"
                                               Text="{TemplateBinding Content}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- زرار العنصر النشط حاليًا (القسم المفتوح) — بلون التمييز البرتقالي -->
            <Style x:Key="SidebarItemActiveStyle" TargetType="Button" BasedOn="{StaticResource SidebarItemStyle}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource AccentBrush}"
                                    CornerRadius="{StaticResource RadiusMedium}">
                                <DockPanel Margin="14,0" LastChildFill="True">
                                    <TextBlock Text="{Binding Path=(Tag), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Width="26"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               DockPanel.Dock="Right"/>
                                    <TextBlock Text="{TemplateBinding Content}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- عنوان مجموعة صغير (مثلاً "دورة العمل" / "الإدارة المالية") -->
            <Style x:Key="SidebarGroupHeaderStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#6B7078"/>
                <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}"/>
                <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="24,18,24,8"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource PrimaryDarkBrush}">
        <DockPanel LastChildFill="True">

            <!-- ===================== شعار البرنامج ===================== -->
            <Border DockPanel.Dock="Top" Height="76" Padding="20,0">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Width="38" Height="38"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="{StaticResource RadiusSmall}">
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="الورشة" Foreground="White" FontWeight="Bold"
                               FontFamily="{StaticResource FontFamilyBase}"
                               FontSize="{StaticResource FontSizeH2}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>

            <!-- ===================== زرار تسجيل الخروج (أسفل القائمة دايمًا) ===================== -->
            <Button DockPanel.Dock="Bottom" Content="تسجيل الخروج" Tag="&#xE7E8;"
                    Style="{StaticResource SidebarItemStyle}" Margin="12,10,12,18"/>

            <!-- ===================== قائمة الأقسام (قابلة للتمرير) ===================== -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,6,0,0">
                <StackPanel>

                    <Button x:Name="HomeButton" Content="الرئيسية" Tag="&#xE80F;" Style="{StaticResource SidebarItemActiveStyle}" Click="SidebarButton_Click"/>

                    <TextBlock Text="دورة عمل السيارة" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                    <Button Content="العملاء" Tag="&#xE716;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="السيارات" Tag="&#xE804;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="استلام سيارة" Tag="&#xE8B5;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="أوامر الشغل" Tag="&#xE90F;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="الفنيون" Tag="&#xE77B;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>

                    <TextBlock Text="المخزون والموردون" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                    <Button Content="المخزن" Tag="&#xE7B8;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="الموردون" Tag="&#xE719;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>

                    <TextBlock Text="الإدارة المالية" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                    <Button Content="الفواتير" Tag="&#xE7C3;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="الحسابات" Tag="&#xE8C7;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="المصروفات" Tag="&#xE7BA;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>

                    <TextBlock Text="عام" Style="{StaticResource SidebarGroupHeaderStyle}"/>
                    <Button Content="التقارير" Tag="&#xE9D9;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>
                    <Button Content="الإعدادات" Tag="&#xE713;" Style="{StaticResource SidebarItemStyle}" Click="SidebarButton_Click"/>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</UserControl>
