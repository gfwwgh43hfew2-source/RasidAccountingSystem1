<Window x:Class="RasidAccountingSystem.Views.OpeningInventoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة رصيد افتتاحي" Width="850" Height="650"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.2" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- شريط العنوان -->
            <Border Grid.Row="0" Background="#4F46E5" CornerRadius="16,16,0,0" Padding="15">
                <Grid>
                    <TextBlock Text="إضافة رصيد افتتاحي للمخزون" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button x:Name="btnClose" Content="✕" Width="30" Height="30" Background="Transparent" 
                            Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="16"
                            HorizontalAlignment="Right" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- المحتوى -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- معلومات الرصيد -->
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="رقم الإذن" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <TextBlock x:Name="lblOpeningNumber" FontSize="14" FontWeight="Bold" Foreground="#4F46E5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="المخزن" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <TextBlock x:Name="lblStoreName" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="التاريخ" FontSize="12" Foreground="#6B7280" Margin="0,0,0,5"/>
                            <TextBlock x:Name="lblOpeningDate" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- شريط إضافة منتج -->
                <Border Grid.Row="1" Background="#F3F4F6" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtProductSearch" Grid.Column="0" Height="35" 
                                 TextChanged="TxtProductSearch_TextChanged"/>
                        <TextBox x:Name="txtQuantity" Grid.Column="1" Height="35" Margin="5,0" Text="0" TextAlignment="Center"/>
                        <TextBox x:Name="txtCostPrice" Grid.Column="2" Height="35" Margin="5,0" Text="0" TextAlignment="Center"/>
                        <TextBox x:Name="txtTotalAmount" Grid.Column="3" Height="35" Margin="5,0" IsReadOnly="True" Background="#F9FAFB" TextAlignment="Center"/>
                        <Button x:Name="btnAddProduct" Grid.Column="4" Content="+" Width="35" Height="35" Background="#4F46E5" Foreground="White" 
                                BorderThickness="0" Cursor="Hand" FontSize="18" Click="BtnAddProduct_Click"/>
                    </Grid>
                </Border>

                <!-- قائمة المنتجات المقترحة للبحث -->
                <ListBox x:Name="lstSearchResults" Grid.Row="2" Height="120" Margin="0,0,0,15" 
                         Visibility="Collapsed" SelectionChanged="LstSearchResults_SelectionChanged"/>

                <!-- جدول المنتجات -->
                <DataGrid x:Name="dgProducts" Grid.Row="3" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0"
                          Background="White" BorderBrush="#E2E8F0" BorderThickness="1">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="سعر الشراء" Binding="{Binding CostPrice, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N2}" Width="100"/>
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✗" Width="30" Height="30" Background="#FEF2F2" Foreground="#DC2626"
                                            BorderThickness="0" Cursor="Hand" FontSize="14" FontWeight="Bold"
                                            Click="RemoveProduct_Click" Tag="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- الأزرار -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="15">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="btnSave" Content="حفظ" Width="100" Height="35" Background="#4F46E5" Foreground="White" 
                                BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" 
                                Click="BtnSave_Click"/>
                        <Button x:Name="btnCancel" Content="إلغاء" Width="100" Height="35" Background="White" Foreground="#6B7280" 
                                BorderBrush="#E2E8F0" BorderThickness="1" Cursor="Hand" FontSize="13" FontWeight="SemiBold" 
                                Click="BtnCancel_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="lblTotalValue" Text="الإجمالي: 0.00" FontSize="14" FontWeight="Bold" Foreground="#4F46E5" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>