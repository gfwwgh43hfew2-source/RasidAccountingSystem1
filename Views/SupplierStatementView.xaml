<UserControl x:Class="RasidAccountingSystem.Views.SupplierStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="{StaticResource BackgroundColor}"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- ==================== الألوان ==================== -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0047FF"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#0035CC"/>
        <SolidColorBrush x:Key="PrimarySoft" Color="#E6EEFF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E74C3C"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F39C12"/>
        <SolidColorBrush x:Key="InfoColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6C757D"/>
        <SolidColorBrush x:Key="BorderLightColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BackgroundGrayColor" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>

        <!-- ==================== الظلال ==================== -->
        <DropShadowEffect x:Key="ShadowSm" 
                          BlurRadius="8" 
                          ShadowDepth="1" 
                          Opacity="0.08" 
                          Direction="270"/>

        <!-- ==================== تعريف الأنماط ==================== -->

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="TextBox"
                                                   Grid.Column="0"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Cairo"
                                                   FontSize="11"/>
                                <Button x:Name="DropDownButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="32"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <TextBlock Text="📅"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryColor}"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Center"/>
                                    <ToggleButton x:Name="ToggleButton"
                                                  Grid.Column="1"
                                                  Width="30"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="Transparent">
                                                    <TextBlock x:Name="arrow"
                                                               Text="▼"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextSecondaryColor}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="Text" Value="▲"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   AllowsTransparency="True">
                                <Grid Width="{TemplateBinding ActualWidth}">
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderLightColor}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,1,0,0">
                                        <ScrollViewer MaxHeight="180">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimarySoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcelButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E7E41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Excel" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E4F7A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖨️" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="طباعة" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#143D5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MaxWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Background="#A0B4C8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="4"
                                                        Height="{TemplateBinding Height}"
                                                        Width="6"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Background" Value="#7A8EAA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== العنوان ==================== -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15,12"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📋" FontSize="20" Margin="0,0,10,0"/>
                    <TextBlock Text="كشف حساب المورد"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"
                               FontFamily="Cairo"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="btnRefresh"
                            Content="⟳ تحديث"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"
                            Width="80"/>
                    <Button x:Name="btnExportExcel"
                            Content="📊 Excel"
                            Style="{StaticResource ExcelButton}"
                            Margin="0,0,10,0"/>
                    <Button x:Name="btnPrint"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== شريط الفلاتر ==================== -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- صف 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock Text="اختر المورد" Style="{StaticResource FormLabel}"/>
                    <Grid>
                        <Border x:Name="borderSupplierSearch"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderLightColor}"
                                BorderThickness="1"
                                Background="White">
                            <Grid>
                                <TextBlock x:Name="txtSupplierPlaceholder"
                                           Text="ابحث باسم المورد أو الكود..."
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           Foreground="#999999"
                                           IsHitTestVisible="False"
                                           FontFamily="Cairo"
                                           FontSize="11"/>
                                <TextBox x:Name="txtSupplierSearch"
                                         Style="{StaticResource FormTextBox}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         FontFamily="Cairo"
                                         FontSize="11"
                                         TextChanged="TxtSupplierSearch_TextChanged"
                                         GotFocus="TxtSupplierSearch_GotFocus"
                                         LostFocus="TxtSupplierSearch_LostFocus"
                                         KeyDown="TxtSupplierSearch_KeyDown"
                                         PreviewKeyDown="TxtSupplierSearch_PreviewKeyDown"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="popupSuppliers"
                               PlacementTarget="{Binding ElementName=txtSupplierSearch}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="Slide">
                            <Border Background="White"
                                    BorderBrush="{StaticResource BorderLightColor}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Width="{Binding ActualWidth, ElementName=txtSupplierSearch}">
                                <ListBox x:Name="lstSuppliers"
                                         MaxHeight="200"
                                         Background="White"
                                         BorderThickness="0"
                                         Focusable="True"
                                         IsTabStop="True"
                                         MouseUp="LstSuppliers_MouseUp"
                                         KeyDown="LstSuppliers_KeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8"
                                                    BorderBrush="{StaticResource BorderLightColor}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="Cairo"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryColor}"/>
                                                        <TextBlock Text="{Binding Code}"
                                                                   FontFamily="Cairo"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                                   Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="{StaticResource PrimarySoft}"
                                                            CornerRadius="4"
                                                            Padding="8,3"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Cairo"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource PrimaryColor}"
                                                                   Text="{Binding CurrentBalance, StringFormat=رصيد: {0:N2}}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock Text="من تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpFromDate" Style="{StaticResource FormDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,10">
                    <TextBlock Text="إلى تاريخ" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="dpToDate" Style="{StaticResource FormDatePicker}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,10,10">
                    <TextBlock Text="نوع الحركة" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="cboTransactionType" 
                              Style="{StaticResource FormComboBox}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="الكل"/>
                        <ComboBoxItem Content="مشتريات"/>
                        <ComboBoxItem Content="مدفوعات"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,0,0">
                    <Button x:Name="btnShowStatement"
                            Content="🔍 عرض الكشف"
                            Style="{StaticResource PrimaryButton}"
                            Width="120"/>
                </StackPanel>

                <!-- صف 2 - معلومات المورد -->
                <Border Grid.Row="1" Grid.ColumnSpan="5"
                        Background="{StaticResource PrimarySoft}"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,10,0,0"
                        x:Name="borderSupplierInfo"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="اسم المورد" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock x:Name="lblSupplierName" 
                                       Text="---" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="الكود" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock x:Name="lblSupplierCode" 
                                       Text="---" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رصيد افتتاحي" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock x:Name="lblOpeningBalance" 
                                       Text="0.00" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="إجمالي المشتريات" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock x:Name="lblTotalPurchases" 
                                       Text="0.00" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource SuccessColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="إجمالي المدفوعات" 
                                       FontSize="10" 
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock x:Name="lblTotalPayments" 
                                       Text="0.00" 
                                       FontSize="13" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource DangerColor}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== كشف الحساب ==================== -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- عنوان الجدول -->
                <Border Grid.Row="0"
                        Background="{StaticResource PrimarySoft}"
                        Padding="15,10"
                        CornerRadius="10,10,0,0"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 تفاصيل الحركات"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontFamily="Cairo"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="lblRecordsCount"
                                   Text="عدد السجلات: 0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontFamily="Cairo"/>
                    </Grid>
                </Border>

                <!-- جدول البيانات -->
                <DataGrid x:Name="dgTransactions"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeight="40"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource SurfaceColor}"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="{StaticResource SurfaceColor}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="📅 التاريخ" 
                                            Binding="{Binding TransactionDate}" 
                                            Width="100"/>

                        <DataGridTextColumn Header="📄 نوع المستند" 
                                            Binding="{Binding DocumentType}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="🔢 رقم المستند" 
                                            Binding="{Binding DocumentNumber}" 
                                            Width="120"/>

                        <DataGridTextColumn Header="📝 البيان" 
                                            Binding="{Binding Description}" 
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- تم التصحيح: دائن (مشتريات) - يزيد رصيد المورد -->
                        <DataGridTextColumn Header="💰 دائن (مشتريات)" 
                                            Binding="{Binding CreditAmount, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- تم التصحيح: مدين (مدفوعات) - يقلل رصيد المورد -->
                        <DataGridTextColumn Header="💸 مدين (مدفوعات)" 
                                            Binding="{Binding DebitAmount, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="⚖️ الرصيد بعد" 
                                            Binding="{Binding BalanceAfter, StringFormat=N2}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{Binding BalanceColor}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- شريط الإجمالي -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        Padding="15,12"
                        CornerRadius="0,0,10,10"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="الرصيد النهائي:" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblClosingBalance" 
                                       Text="0.00" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       Margin="10,0,0,0"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblClosingBalanceCurrency"
                                       Text="ر.س" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}" 
                                       Margin="5,0,0,0" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,20,0">
                            <TextBlock Text="إجمالي المشتريات (دائن):" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalCredit" 
                                       Text="0.00" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource SuccessColor}" 
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="إجمالي المدفوعات (مدين):" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="lblTotalDebit" 
                                       Text="0.00" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource DangerColor}" 
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- رسالة عدم وجود بيانات -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundGrayColor}"
                CornerRadius="10"
                Padding="40"
                x:Name="lblNoData"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="لا توجد حركات للمورد في الفترة المحددة"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryColor}"
                           HorizontalAlignment="Center"
                           FontFamily="Cairo"/>
                <TextBlock Text="الرجاء اختيار مورد آخر أو تغيير نطاق التواريخ"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"
                           FontFamily="Cairo"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>