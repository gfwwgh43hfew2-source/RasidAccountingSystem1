<UserControl x:Class="RasidAccountingSystem.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BackgroundColor}">

    <UserControl.Resources>

        <!-- ==================== ألوان الموردين (برتقالي/ذهبي) ==================== -->

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FFF3E0"/>
            <Setter Property="Foreground" Value="#ED6C02"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE0B2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CenterDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#ED6C02"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftAlignDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#ED6C02"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="5" Background="#D1FAE5">
                            <TextBlock x:Name="content" 
                                       Text="نشط" 
                                       Foreground="#047857" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="content" Property="Text" Value="غير نشط"/>
                                <Setter TargetName="content" Property="Foreground" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- الهيدر العلوي -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceColor}" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="8" ShadowDepth="1" Direction="270"/>
            </Border.Effect>

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- بطاقة الإحصائيات بلون برتقالي (زوايا حادة) -->
                <Border Grid.Row="0" Background="#ED6C02" Padding="12" Margin="0,0,0,12" CornerRadius="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="24" Height="24" Margin="0,0,10,0">
                                <Path Fill="#FFB74D" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الموردين" FontSize="11" Foreground="#FFE0B2" Margin="0,0,0,2"/>
                                <TextBlock x:Name="lblTotalSuppliers" Text="0" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="مورد نشط" FontSize="11" Foreground="#FFE0B2" VerticalAlignment="Center" Margin="0,0,15,0"/>

                        <Button x:Name="btnRefresh" Grid.Column="3" Width="32" Height="32" Background="#30FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="تحديث البيانات">
                            <Viewbox Width="16" Height="16">
                                <Path Fill="White" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- شريط البحث والأزرار -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="قائمة الموردين" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextPrimaryColor}"/>
                        <Border Background="#FFF3E0" Padding="6,1" CornerRadius="6" VerticalAlignment="Center">
                            <TextBlock x:Name="lblTotalBadge" Text="0" Foreground="#ED6C02" FontWeight="Bold" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">

                        <Grid Margin="0,0,10,0">
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Width="220" Height="34"/>
                            <Path Fill="#9CA3AF" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.3,20.41L13.04,15.11C12.03,15.82 10.81,16.25 9.5,16.25A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                  Width="14" Height="14" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="ابحث بالاسم أو الكود أو الهاتف..." Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0,32,0" IsHitTestVisible="False" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=txtSearch}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="txtSearch" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0,30,0" FontSize="11"/>
                        </Grid>

                        <!-- زر استيراد Excel بلون أخضر (مصغر) -->
                        <Button x:Name="btnImportExcel" Height="34" Width="100" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Fill="White" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,3.5L18.5,9H13V3.5M12,12L15,15H13V19H11V15H9L12,12Z"/>
                                </Viewbox>
                                <TextBlock Text="استيراد Excel" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- زر إضافة مورد بلون برتقالي (مصغر) -->
                        <Button x:Name="btnAddSupplier" Height="34" Width="100" Background="#ED6C02" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Fill="White" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                </Viewbox>
                                <TextBlock Text="مورد جديد" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- منطقة الجدول الرئيسية -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundColor}" Padding="15">
            <Border Background="{StaticResource SurfaceColor}" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- شريط التحديد الجماعي -->
                    <Border x:Name="BulkBar" Grid.Row="0" Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="12,12,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="BulkText" Foreground="#BE123C" FontSize="11" FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnBulkDelete" Content="حذف المحدد" Background="#E11D48" Foreground="White" Padding="12,5" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="SemiBold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- جدول الموردين -->
                    <DataGrid x:Name="dgSuppliers" Grid.Row="1" Margin="12"
                              HorizontalAlignment="Stretch"
                              AutoGenerateColumns="False" 
                              SelectionMode="Extended" 
                              SelectionUnit="FullRow"
                              CanUserAddRows="False" 
                              CanUserDeleteRows="False" 
                              HeadersVisibility="Column"
                              RowHeaderWidth="0" 
                              Background="Transparent" 
                              BorderThickness="0"
                              GridLinesVisibility="None" 
                              RowHeight="42" 
                              EnableRowVirtualization="True"
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Height" Value="38"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Margin" Value="0,1,0,0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FFF3E0"/>
                                        <Setter Property="BorderBrush" Value="#FFB74D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <!-- عمود الاختيار -->
                            <DataGridTemplateColumn Width="40" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox x:Name="HeaderCheckBox" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  Checked="HeaderCheckBox_Checked"
                                                  Unchecked="HeaderCheckBox_Unchecked"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- كود المورد -->
                            <DataGridTemplateColumn Header="الكود" Width="80" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SupplierCode}" 
                                                   Foreground="#ED6C02" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,15,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- اسم المورد -->
                            <DataGridTemplateColumn Header="اسم المورد" Width="*" CellStyle="{StaticResource LeftAlignDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SupplierNameAr}" 
                                                   HorizontalAlignment="Left" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Left"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="5,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم الهاتف -->
                            <DataGridTemplateColumn Header="رقم الهاتف" Width="110" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Phone}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رصيد أول المدة -->
                            <DataGridTemplateColumn Header="رصيد أول المدة" Width="100" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OpeningBalance, StringFormat=N2}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="#6B7280"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الرصيد الحالي -->
                            <DataGridTemplateColumn Header="الرصيد الحالي" Width="100" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CurrentBalance, StringFormat=N2}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="#ED6C02"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الحد الائتماني -->
                            <DataGridTemplateColumn Header="الحد الائتماني" Width="90" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreditLimit, StringFormat=N2}" 
                                                   HorizontalAlignment="Center" 
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   Foreground="#6B7280"
                                                   FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الحالة -->
                            <DataGridTemplateColumn Header="الحالة" Width="70" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsActive}" 
                                                      Style="{StaticResource StatusButtonStyle}"
                                                      Tag="{Binding SupplierID}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الإجراءات -->
                            <DataGridTemplateColumn Header="إجراءات" Width="115" CellStyle="{StaticResource CenterDataGridCellStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center" 
                                                    VerticalAlignment="Center">
                                            <Button Content="تعديل" 
                                                    Style="{StaticResource EditButtonStyle}" 
                                                    Tag="{Binding SupplierID}"
                                                    Click="EditRow_Click"/>
                                            <Button Content="حذف" 
                                                    Style="{StaticResource DeleteButtonStyle}" 
                                                    Tag="{Binding SupplierID}"
                                                    Click="DeleteRow_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- رسالة عدم وجود بيانات -->
                    <StackPanel Grid.Row="1" x:Name="lblNoData" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Fill="#CBD5E1" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="48" Height="48" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="لا يوجد موردين مسجلين حتى الآن" FontSize="14" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="اضغط على زر إضافة جديد للبدء" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,5,0,0" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- شريط الترقيم -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10" CornerRadius="0,0,10,10">
                        <Grid>
                            <TextBlock x:Name="lblPaginationInfo" Text="عرض 0 إلى 0 من أصل 0 مورد" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="btnPrevPage" Content="← السابق" Width="70" Height="28" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569" Cursor="Hand" Margin="0,0,8,0" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <Border Background="#FFF3E0" BorderThickness="1" BorderBrush="#FFB74D" CornerRadius="5" Width="30" Height="28">
                                    <TextBlock x:Name="lblPageInfo" Text="1" 
                                               Foreground="#ED6C02" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center" 
                                               FontSize="11" 
                                               TextAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage" Content="التالي →" Width="70" Height="28" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Foreground="#475569" Cursor="Hand" Margin="8,0,0,0" FontSize="11">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>

    </Grid>
</UserControl>