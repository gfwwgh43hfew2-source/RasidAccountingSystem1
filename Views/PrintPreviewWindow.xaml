<Window x:Class="RasidAccountingSystem.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="معاينة قبل الطباعة"
        Height="800" 
        Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="PreviewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" 
                                        Property="Background" 
                                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"/>
                                <Setter TargetName="border" 
                                        Property="Opacity" 
                                        Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات العلوي -->
        <Border Grid.Row="0" 
                Background="#2C3E50" 
                Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnPrint" 
                        Content="🖨️ طباعة" 
                        Background="#3498DB" 
                        Style="{StaticResource PreviewButtonStyle}"
                        Click="BtnPrint_Click"/>
                <Button x:Name="btnZoomIn" 
                        Content="➕ تكبير" 
                        Background="#27AE60" 
                        Style="{StaticResource PreviewButtonStyle}"
                        Click="BtnZoomIn_Click"/>
                <Button x:Name="btnZoomOut" 
                        Content="➖ تصغير" 
                        Background="#E67E22" 
                        Style="{StaticResource PreviewButtonStyle}"
                        Click="BtnZoomOut_Click"/>
                <Button x:Name="btnFitToWidth" 
                        Content="📏 ملاءمة للعرض" 
                        Background="#8E44AD" 
                        Style="{StaticResource PreviewButtonStyle}"
                        Click="BtnFitToWidth_Click"/>
                <Button x:Name="btnClose" 
                        Content="✖ إغلاق" 
                        Background="#E74C3C" 
                        Style="{StaticResource PreviewButtonStyle}"
                        Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Document Viewer لعرض المعاينة -->
        <DocumentViewer x:Name="docViewer" Grid.Row="1" Background="#F5F5F5"/>

        <!-- شريط الحالة السفلي -->
        <Border Grid.Row="2" 
                Background="#34495E" 
                Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="lblStatus" 
                           Text="جاهز" 
                           Foreground="White" 
                           FontFamily="Cairo" 
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="lblPageInfo" 
                           Grid.Column="1"
                           Text="صفحة 1 من 1" 
                           Foreground="#CCCCCC" 
                           FontFamily="Cairo" 
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,15,0"/>
                <TextBlock x:Name="lblZoomInfo" 
                           Grid.Column="2"
                           Text="100%" 
                           Foreground="#CCCCCC" 
                           FontFamily="Cairo" 
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>