<UserControl x:Class="RasidAccountingSystem.Views.CustomersBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Background="#F5F3FF"
             FlowDirection="RightToLeft"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- الألوان الخاصة بميزان العملاء -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="PrimaryDark" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PrimarySoft" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1E1B4B"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#6B7280"/>
        <SolidColorBrush x:Key="BorderLightColor" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BackgroundGrayColor" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>

        <!-- الظلال -->
        <DropShadowEffect x:Key="ShadowSm" 
                          BlurRadius="6" 
                          ShadowDepth="1" 
                          Opacity="0.06" 
                          Direction="270"/>

        <!-- تعريف الأنماط -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimarySoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExcelButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E7E41"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="Excel" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#166534"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrintButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E4F7A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖨️" FontSize="11" Margin="0,0,5,0"/>
                                <TextBlock Text="طباعة" FontSize="10"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#143D5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط رأس العمود -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- نمط خلية البيانات -->
        <Style TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="Cairo"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLightColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- شريط العنوان والأزرار -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="12,10"
                Margin="0,0,0,8"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👥" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="ميزان العملاء"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryColor}"
                               FontFamily="Cairo"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshButton"
                            Content="⟳ تحديث"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Width="70"/>
                    <Button x:Name="ExportExcelButton"
                            Content="📊 Excel"
                            Style="{StaticResource ExcelButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button x:Name="PrintButton"
                            Content="🖨️ طباعة"
                            Style="{StaticResource PrintButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- جدول العملاء -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                BorderBrush="{StaticResource BorderLightColor}"
                BorderThickness="1"
                Effect="{StaticResource ShadowSm}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- عنوان الجدول -->
                <Border Grid.Row="0"
                        Background="{StaticResource PrimarySoft}"
                        Padding="12,8"
                        CornerRadius="8,8,0,0"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📋 قائمة العملاء"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryColor}"
                                   FontFamily="Cairo"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="RecordsCountText"
                                   Text="عدد العملاء: 0"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontFamily="Cairo"/>
                    </Grid>
                </Border>

                <!-- جدول البيانات -->
                <DataGrid x:Name="CustomersDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="White"
                          RowHeaderWidth="0"
                          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True">

                    <DataGrid.Columns>
                        <!-- عمود الرقم التسلسلي -->
                        <DataGridTextColumn Header="م" 
                                            Binding="{Binding SerialNumber}" 
                                            Width="45">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود كود العميل -->
                        <DataGridTextColumn Header="كود العميل" 
                                            Binding="{Binding CustomerCode}" 
                                            Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود اسم العميل -->
                        <DataGridTextColumn Header="اسم العميل" 
                                            Binding="{Binding CustomerName}" 
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود رصيد أول المدة -->
                        <DataGridTextColumn Header="💵 رصيد أول المدة" 
                                            Binding="{Binding OpeningBalance, StringFormat=N0}" 
                                            Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود مدين (مبيعات) -->
                        <DataGridTextColumn Header="💰 مدين (مبيعات)" 
                                            Binding="{Binding TotalSales, StringFormat=N0}" 
                                            Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource DangerColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود دائن (متحصلات) -->
                        <DataGridTextColumn Header="💸 دائن (متحصلات)" 
                                            Binding="{Binding TotalCollections, StringFormat=N0}" 
                                            Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource SuccessColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود الرصيد الحالي -->
                        <DataGridTextColumn Header="⚖️ الرصيد الحالي" 
                                            Binding="{Binding CurrentBalance, StringFormat=N0}" 
                                            Width="105">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{Binding BalanceColor}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- عمود حالة الحساب -->
                        <DataGridTemplateColumn Header="📊 حالة الحساب" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="5,2" 
                                            Background="{Binding StatusBg}"
                                            CornerRadius="10"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding BalanceStatus}" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding StatusColor}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- شريط الإجمالي -->
                <Border Grid.Row="2"
                        Background="#F8FAFC"
                        Padding="10,8"
                        CornerRadius="0,0,8,8"
                        BorderBrush="{StaticResource BorderLightColor}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- إجمالي رصيد أول المدة -->
                        <Border Grid.Column="0" 
                                Background="#FEF3C7" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي رصيد أول المدة:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center" FontFamily="Cairo"/>
                                <TextBlock x:Name="TotalOpeningBalanceText" Text="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningColor}" Margin="6,0,0,0" FontFamily="Cairo"/>
                                <TextBlock x:Name="lblCurrencyOpening" Text="ر.س" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" Margin="3,0,0,0" VerticalAlignment="Center" FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>

                        <!-- إجمالي المبيعات -->
                        <Border Grid.Column="1" 
                                Background="#FEE2E2" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                Margin="10,0,10,0" 
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي المبيعات:" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center" FontFamily="Cairo"/>
                                <TextBlock x:Name="TotalSalesText" Text="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource DangerColor}" Margin="6,0,0,0" FontFamily="Cairo"/>
                                <TextBlock x:Name="lblCurrencySales" Text="ر.س" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" Margin="3,0,0,0" VerticalAlignment="Center" FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>

                        <!-- إجمالي المتحصلات -->
                        <Border Grid.Column="2" 
                                Background="#D1FAE5" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                Margin="0,0,10,0" 
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي المتحصلات:" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center" FontFamily="Cairo"/>
                                <TextBlock x:Name="TotalCollectionsText" Text="0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SuccessColor}" Margin="6,0,0,0" FontFamily="Cairo"/>
                                <TextBlock x:Name="lblCurrencyCollections" Text="ر.س" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" Margin="3,0,0,0" VerticalAlignment="Center" FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>

                        <!-- إجمالي الرصيد -->
                        <Border Grid.Column="3" 
                                Background="{StaticResource PrimarySoft}" 
                                CornerRadius="6" 
                                Padding="10,4" 
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="إجمالي الرصيد:" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryColor}" VerticalAlignment="Center" FontFamily="Cairo"/>
                                <TextBlock x:Name="TotalBalanceText" Text="0" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryColor}" Margin="6,0,0,0" FontFamily="Cairo"/>
                                <TextBlock x:Name="lblCurrencyTotal" Text="ر.س" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" Margin="3,0,0,0" VerticalAlignment="Center" FontFamily="Cairo"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- رسالة عدم وجود بيانات -->
        <Border Grid.Row="1"
                Background="{StaticResource BackgroundGrayColor}"
                CornerRadius="8"
                Padding="30"
                x:Name="NoDataMessage"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="👥" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="لا توجد عملاء مسجلين في النظام" FontSize="12" Foreground="{StaticResource TextSecondaryColor}" HorizontalAlignment="Center" FontFamily="Cairo"/>
                <TextBlock Text="الرجاء إضافة عملاء أولاً" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Cairo"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>