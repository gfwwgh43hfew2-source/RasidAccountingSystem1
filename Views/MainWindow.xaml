        <!-- الخط الأساسي -->
        <FontFamily x:Key="ArabicFont">Cairo</FontFamily>

        <!-- أيقونة السهم -->
        <BitmapImage x:Key="IconArrowDown" UriSource="/assets/icons/arrow-down.png"/>
        <BitmapImage x:Key="IconBell" UriSource="/assets/icons/bell.png"/>
        <BitmapImage x:Key="IconLogo" UriSource="/assets/icons/logo.png"/>

        <!-- أنماط الأزرار -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,0,8,0">
                            <DockPanel LastChildFill="True" Margin="12,0">
                                <Image Source="{TemplateBinding Tag}" Width="18" Height="18" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ButtonText" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" TextAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarGroupButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DockPanel Grid.Column="0" LastChildFill="True" Margin="12,0">
                                    <Image Source="{TemplateBinding Tag}" Width="18" Height="18" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="ButtonText" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" TextAlignment="Right" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Image x:Name="arrowIcon" Grid.Column="1" Source="{StaticResource IconArrowDown}" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Image.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Image.RenderTransform>
                                    <Image.RenderTransformOrigin>
                                        <Point X="0.5" Y="0.5"/>
                                    </Image.RenderTransformOrigin>
                                </Image>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarSubButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,0,16,0">
                            <DockPanel LastChildFill="True" Margin="20,0">
                                <Image Source="{TemplateBinding Tag}" Width="16" Height="16" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ButtonText" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" TextAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="ButtonText" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarMenuButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="12,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock x:Name="menuIcon" Text="☰" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource ArabicFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="12,8,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Image Source="{StaticResource IconLogoutWhite}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LogoutText" Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyleCollapsed" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="11,8,11,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Image Source="{StaticResource IconLogoutWhite}" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource HeaderText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E7E0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E7E0D2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E7E0D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#E7E0D2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.05" Color="Black"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAF7F0"/>
                    <Setter Property="BorderBrush" Value="#D8CDB8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="NotificationItemTemplate">
            <Border Style="{StaticResource NotificationItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{Binding IconBackground}" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#24211D" FontFamily="{StaticResource ArabicFont}"/>
                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#6B6156" TextWrapping="Wrap" Margin="0,4,0,0" FontFamily="{StaticResource ArabicFont}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TimeDisplay}" FontSize="9" Foreground="#97896F" FontFamily="{StaticResource ArabicFont}"/>
                            <Border Width="3" Height="3" CornerRadius="1.5" Background="#D8CDB8" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CategoryName}" FontSize="9" Foreground="{Binding CategoryColor}" FontFamily="{StaticResource ArabicFont}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Width="20" Height="20" Content="✕" FontSize="10" Foreground="#97896F" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="8,0,0,0" VerticalAlignment="Top" Click="CloseNotification_Click" Tag="{Binding Id}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="NotificationsPopupStyle" TargetType="Popup">
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Placement" Value="Bottom"/>
            <Setter Property="PlacementTarget" Value="{Binding ElementName=btnNotifications}"/>
            <Setter Property="VerticalOffset" Value="8"/>
            <Setter Property="HorizontalOffset" Value="-220"/>
            <Setter Property="StaysOpen" Value="False"/>
            <Setter Property="Focusable" Value="True"/>
        </Style>

    </Window.Resources>

    <Border Background="Transparent">
        <Border Background="White" CornerRadius="16" Margin="5" Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HeaderBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource HeaderBg}" BorderBrush="#E7E0D2" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0">
                                    <Button x:Name="btnClose" Content="✕" Style="{StaticResource ControlButtonStyle}" Foreground="#DC2626"/>
                                    <Button x:Name="btnMaximize" Content="□" Style="{StaticResource ControlButtonStyle}" Margin="6,0"/>
                                    <Button x:Name="btnMinimize" Content="─" Style="{StaticResource ControlButtonStyle}"/>
                                </StackPanel>

                                <TextBlock x:Name="lblPageTitle" Text="لوحة التحكم" FontSize="15" FontWeight="SemiBold" Foreground="#24211D" FontFamily="{StaticResource ArabicFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock x:Name="lblWelcome" Text="مرحباً" FontSize="12" FontWeight="Bold" Foreground="#0F5C46" VerticalAlignment="Center" Margin="0,0,5,0" FontFamily="{StaticResource ArabicFont}"/>
                                    <TextBlock x:Name="lblUsername" Text="" FontSize="12" FontWeight="Bold" Foreground="#0F5C46" VerticalAlignment="Center" Margin="0,0,15,0" FontFamily="{StaticResource ArabicFont}"/>

                                    <Button x:Name="btnSettingsHeader" Style="{StaticResource ControlButtonStyle}" Click="BtnSettingsHeader_Click" Width="34" Height="34" Margin="0,0,2,0" ToolTip="الإعدادات">
                                        <Image Source="{StaticResource IconSettingsWhite}" Width="18" Height="18" Stretch="Uniform"/>
                                    </Button>

                                    <ToggleButton x:Name="btnNotifications" Style="{StaticResource ToggleButtonStyle}" Click="BtnNotifications_Click" Width="34" Height="34">
                                        <Grid>
                                            <Image Source="{StaticResource IconBell}" Width="18" Height="18" Stretch="Uniform"/>
                                            <Border x:Name="NotificationBadge" MinWidth="16" Height="16" CornerRadius="8" Background="#DC2626" BorderBrush="White" BorderThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0" Padding="4,0,4,0" Visibility="Collapsed">
                                                <TextBlock x:Name="NotificationCount" Text="0" FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FAF7F0" Padding="12">
                            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
                        </Border>

                        <Border Grid.Row="2" Background="{StaticResource HeaderBg}" BorderBrush="#E7E0D2" BorderThickness="0,1,0,0">
                            <TextBlock x:Name="lblCopyright" Text="جميع الحقوق محفوظة - نظام راصد المحاسبي © 2025" FontSize="10" Foreground="#97896F" FontFamily="{StaticResource ArabicFont}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="SidebarPanel" Grid.Column="1" Width="240" Background="{StaticResource SidebarBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Button x:Name="btnToggleSidebar" Grid.Row="0" Style="{StaticResource SidebarMenuButton}"/>

                        <Border x:Name="LogoBorder" Grid.Row="1" Width="60" Height="60" CornerRadius="30" Background="White" Margin="0,8,0,8" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
                            <Border.Clip>
                                <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                            </Border.Clip>
                            <Image x:Name="LogoImage" Stretch="UniformToFill" StretchDirection="Both" Width="60" Height="60" RenderOptions.BitmapScalingMode="HighQuality" Source="{StaticResource IconLogo}"/>
                        </Border>

                        <TextBlock x:Name="LogoText" Grid.Row="2" Text="نظام راصد" FontSize="14" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource ArabicFont}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MenuStackPanel" Margin="0,20,0,0">

                                <Button x:Name="btnDashboard" Tag="{StaticResource IconDashboardWhite}" Content="لوحة التحكم" Style="{StaticResource SidebarNavButton}"/>
                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnAccounts" Tag="{StaticResource IconAccountsWhite}" Content="الحسابات والخزينة" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="AccountsSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnTreasury" Tag="{StaticResource IconTreasuryWhite}" Content="   الخزينة" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnReceiptVouchers" Tag="{StaticResource IconReceiptWhite}" Content="   سندات القبض" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnPaymentVoucher" Tag="{StaticResource IconPaymentWhite}" Content="   سندات الصرف" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnBank" Tag="{StaticResource IconBankWhite}" Content="   الحسابات البنكية" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnChecks" Tag="{StaticResource IconChecksWhite}" Content="   إدارة الشيكات" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnCustodyGroup" Tag="{StaticResource IconCustodyWhite}" Content="العهد والسلف" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="CustodySubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnCustody" Tag="{StaticResource IconCustodyWhite}" Content="   إدارة العهد" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnHrGroup" Tag="{StaticResource IconEmployeesWhite}" Content="الموارد البشرية" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="HrSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnEmployees" Tag="{StaticResource IconEmployeesWhite}" Content="   الموظفين" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnInventory" Tag="{StaticResource IconInventoryWhite}" Content="المخزون والمستودعات" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="InventorySubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnWarehouse" Tag="{StaticResource IconWarehouseWhite}" Content="   المخازن" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnStoreBalance" Tag="{StaticResource IconStoreBalanceWhite}" Content="   أرصدة المخازن" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnItemCard" Tag="{StaticResource IconItemCardWhite}" Content="   كارتة صنف" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnInventoryAdjustment" Tag="{StaticResource IconInventoryAdjustmentWhite}" Content="   التسويات الجردية" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnSalesGroup" Tag="{StaticResource IconSalesWhite}" Content="فواتير البيع" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="SalesSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnSalesInvoice" Tag="{StaticResource IconSalesInvoiceWhite}" Content="   فواتير البيع" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnSalesReturnInvoice" Tag="{StaticResource IconSalesWhite}" Content="   مرتجعات البيع" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnPurchaseGroup" Tag="{StaticResource IconPurchaseWhite}" Content="فواتير المشتريات" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="PurchaseSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnPurchaseInvoice" Tag="{StaticResource IconPurchaseInvoiceWhite}" Content="   فواتير المشتريات" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnPurchaseReturnInvoice" Tag="{StaticResource IconPurchaseWhite}" Content="   مرتجعات المشتريات" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnSuppliersGroup" Tag="{StaticResource IconSuppliersWhite}" Content="الموردين" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="SuppliersSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnSuppliers" Tag="{StaticResource IconSuppliersWhite}" Content="   الموردين" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnSuppliersBalance" Tag="{StaticResource IconSuppliersBalanceWhite}" Content="   ميزان الموردين" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnSupplierStatement" Tag="{StaticResource IconSupplierStatementWhite}" Content="   كشف حساب مورد" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnCustomersGroup" Tag="{StaticResource IconCustomersWhite}" Content="العملاء" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="CustomersSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnCustomers" Tag="{StaticResource IconCustomersWhite}" Content="   العملاء" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnCustomersBalance" Tag="{StaticResource IconCustomersBalanceWhite}" Content="   ميزان العملاء" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnCustomerStatement" Tag="{StaticResource IconCustomerStatementWhite}" Content="   كشف حساب عميل" Style="{StaticResource SidebarSubButton}"/>
                                    <Button x:Name="btnReceivables" Tag="{StaticResource IconReceivablesWhite}" Content="   📋 المستحقات" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnProductsGroup" Tag="{StaticResource IconProductsWhite}" Content="المنتجات" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="ProductsSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnProducts" Tag="{StaticResource IconProductsWhite}" Content="   المنتجات والخدمات" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnReportsGroup" Tag="{StaticResource IconReportsWhite}" Content="التقارير" Style="{StaticResource SidebarGroupButton}"/>
                                <StackPanel x:Name="ReportsSubMenu" Visibility="Collapsed">
                                    <Button x:Name="btnProfitLoss" Tag="{StaticResource IconProfitWhite}" Content="   الأرباح والخسائر" Style="{StaticResource SidebarSubButton}"/>
                                </StackPanel>

                                <Border Height="0.5" Background="#1F4436" Margin="16,8,16,8" Opacity="0.3"/>

                                <Button x:Name="btnAuditLog" Tag="{StaticResource IconReportsWhite}" Content="سجل التعديلات" Style="{StaticResource SidebarNavButton}"/>
                                <Button x:Name="btnPermissions" Tag="{StaticResource IconSettingsWhite}" Content="إدارة الصلاحيات" Style="{StaticResource SidebarNavButton}"/>
                                <Button x:Name="btnSettings" Tag="{StaticResource IconSettingsWhite}" Content="الإعدادات والخيارات" Style="{StaticResource SidebarNavButton}"/>

                            </StackPanel>
                        </ScrollViewer>

                        <Border x:Name="LogoutBorder" Grid.Row="4" Height="58" Background="#0B2E22" BorderBrush="#24211D" BorderThickness="0,0.5,0,0">
                            <Button x:Name="btnLogout" Content="تسجيل الخروج" Style="{StaticResource LogoutButtonStyle}" Margin="12,6,12,12"/>
                        </Border>
                    </Grid>
                </Border>

                <Popup x:Name="NotificationsPopup" Style="{StaticResource NotificationsPopupStyle}" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=btnNotifications}" VerticalOffset="8" HorizontalOffset="-220" StaysOpen="False" Focusable="True">
                    <Border Background="White" CornerRadius="12" BorderBrush="#E7E0D2" BorderThickness="1" Width="360" MaxHeight="500" Effect="{StaticResource PopupShadow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FAF7F0" CornerRadius="12,12,0,0" Padding="12,10" BorderBrush="#E7E0D2" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="التنبيهات" FontSize="14" FontWeight="Bold" Foreground="#24211D" FontFamily="{StaticResource ArabicFont}" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="btnMarkAllRead" Content="تحديد الكل كمقروء" FontSize="11" Foreground="#0F5C46" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0" Click="BtnMarkAllRead_Click" FontFamily="{StaticResource ArabicFont}"/>
                                        <Button x:Name="btnClearAll" Content="مسح الكل" FontSize="11" Foreground="#DC2626" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnClearAll_Click" FontFamily="{StaticResource ArabicFont}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,8,8,4">
                                <ItemsControl x:Name="NotificationsList" ItemTemplate="{StaticResource NotificationItemTemplate}">
                                    <ItemsControl.Template>
                                        <ControlTemplate>
                                            <StackPanel IsItemsHost="True"/>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border x:Name="EmptyNotificationsPanel" Grid.Row="1" Background="White" Padding="20" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="🔔" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="لا توجد تنبيهات جديدة" FontSize="13" Foreground="#97896F" FontFamily="{StaticResource ArabicFont}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Background="#FAF7F0" CornerRadius="0,0,12,12" Padding="12,8" BorderBrush="#E7E0D2" BorderThickness="0,1,0,0">
                                <Button x:Name="btnViewAllNotifications" Content="عرض جميع التنبيهات" FontSize="11" FontWeight="SemiBold" Foreground="#0F5C46" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Click="BtnViewAllNotifications_Click" FontFamily="{StaticResource ArabicFont}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>

            </Grid>
        </Border>
    </Border>
</Window>