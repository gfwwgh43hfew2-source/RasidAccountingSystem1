<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!--
      كل الـ HintPath في RasidAccountingSystem.csproj بتشاور على "..\packages"
      (يعني مجلد واحد فوق مكان الـ csproj والـ sln). الإعداد الافتراضي في
      Visual Studio بينزّل المكتبات جنب الـ .sln مباشرة (نفس المستوى)، مش فوقه،
      فبيحصل تعارض: المكتبات بتتنزل في مكان والمشروع بيدور عليها في مكان تاني.
      السطر ده بيجبر NuGet يحط مجلد packages في المكان الصح بالظبط.
    -->
    <add key="repositoryPath" value="..\packages" />
  </config>
</configuration>
